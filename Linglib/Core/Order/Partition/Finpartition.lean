/-!
# Partitions generated by functions

The partition of a finite type generated by a function `s : ι → β` has the fibres of `s` as its
blocks, `i` and `j` sharing a block when `s i = s j`; every partition of `ι` is generated by the
function sending each element to its block (`ofFun_part`). Permutations of `ι` act on its
partitions by relabelling, and the multiset of block sizes is invariant. A partition of `Fin n`
is also generated by labelling each element with the least element of its block
(`ofFun_minLabel`), and the label sequences arising this way are those built by appending at
each step an earlier label or the next index: the tables of the Chinese restaurant process
labelled by their first customer.

## Main definitions

* `Finpartition.ofFun s`: the partition of `ι` generated by `s`.
* `Finpartition.partSizes P`: the multiset of the sizes of the blocks.
* The action of `Equiv.Perm ι` on `Finpartition (univ : Finset ι)`.
* `Finpartition.minLabel P`: the labelling of a partition of `Fin n` by the least element of
  each block.

## Main results

* `Finpartition.ofFun_congr`: the partition depends only on which values coincide.
* `Finpartition.ofFun_part`, `Finpartition.ofFun_minLabel`: every partition is generated by its
  blocks, and by its least-element labelling.
* `Finpartition.partSizes_ofFun`: the block sizes are the multiplicities of the values.
* `Finpartition.ofFun_comp_perm`, `Finpartition.partSizes_smul`: precomposing with a permutation
  relabels the partition, which keeps its block sizes.
* `Finpartition.minLabel_ofFun_snoc`, `Finpartition.minLabel_ofFun_of_snoc`: a sequence of
  least-element labels extends by exactly an earlier label or the next index.

[UPSTREAM] candidates for `Mathlib.Order.Partition.Finpartition`.
-/

@[expose] public section

open Finset

namespace Finpartition

variable {ι β : Type*} [Fintype ι] [DecidableEq ι] [DecidableEq β]

/-- The partition of `ι` generated by `s`: two elements share a block when `s` takes the same
value at both. -/
def ofFun (s : ι → β) : Finpartition (univ : Finset ι) :=
  @ofSetoid _ _ _ (Setoid.ker s) fun a b ↦ inferInstanceAs (Decidable (s a = s b))

theorem parts_ofFun (s : ι → β) :
    (ofFun s).parts = univ.image fun i ↦ ({j | s i = s j} : Finset ι) := by
  rw [ofFun, ofSetoid, ofSetSetoid_parts]
  rfl

theorem mem_part_ofFun {s : ι → β} {i j : ι} : j ∈ (ofFun s).part i ↔ s i = s j := by
  rw [ofFun, mem_part_ofSetoid_iff_rel]
  rfl

/-- The partition generated by a function depends only on which of its values coincide. -/
theorem ofFun_congr {γ : Type*} [DecidableEq γ] {s : ι → β} {t : ι → γ}
    (h : ∀ i j, s i = s j ↔ t i = t j) : ofFun s = ofFun t := by
  ext B
  simp only [parts_ofFun, h]

/-- Every partition of `ι` is generated by the function sending each element to its block. -/
theorem ofFun_part (P : Finpartition (univ : Finset ι)) : ofFun P.part = P := by
  ext B
  simp only [parts_ofFun, mem_image, mem_univ, true_and]
  constructor
  · rintro ⟨i, rfl⟩
    convert P.part_mem.2 (mem_univ i) using 1
    ext j
    simp only [mem_filter, mem_univ, true_and]
    rw [P.mem_part_iff_part_eq_part (mem_univ j) (mem_univ i), eq_comm]
  · intro hB
    obtain ⟨i, hi⟩ := P.nonempty_of_mem_parts hB
    refine ⟨i, ?_⟩
    rw [← P.part_eq_of_mem hB hi]
    ext j
    simp only [mem_filter, mem_univ, true_and]
    rw [P.mem_part_iff_part_eq_part (mem_univ j) (mem_univ i), eq_comm]

/-- The multiset of the sizes of the blocks. -/
def partSizes {s : Finset ι} (P : Finpartition s) : Multiset ℕ := P.parts.val.map card

omit [Fintype ι] in
/-- The block sizes add up to the size of the partitioned set. -/
@[simp]
theorem sum_partSizes {s : Finset ι} (P : Finpartition s) : P.partSizes.sum = #s := by
  rw [partSizes, ← P.sum_card_parts, sum_eq_multiset_sum]

/-- The block sizes of the partition generated by `s` are the multiplicities of its values. -/
theorem partSizes_ofFun (s : ι → β) :
    (ofFun s).partSizes = (univ.image s).val.map fun v ↦ #{i | s i = v} := by
  have hp : (ofFun s).parts = (univ.image s).image fun v ↦ ({j | v = s j} : Finset ι) := by
    rw [parts_ofFun, image_image]
    rfl
  have hinj : Set.InjOn (fun v ↦ ({j | v = s j} : Finset ι)) (univ.image s : Set β) := by
    rintro v hv w - h
    obtain ⟨i, -, rfl⟩ := mem_image.1 hv
    have : i ∈ ({j | s i = s j} : Finset ι) := by simp
    rw [show ({j | s i = s j} : Finset ι) = ({j | w = s j} : Finset ι) from h] at this
    exact (by simpa using this : w = s i).symm
  rw [partSizes, hp, image_val_of_injOn hinj, Multiset.map_map]
  congr 1
  funext v
  simp [eq_comm]

/-- The partition generated by `s` has one block per value. -/
@[simp]
theorem card_partSizes_ofFun (s : ι → β) : (ofFun s).partSizes.card = #(univ.image s) := by
  rw [partSizes_ofFun, Multiset.card_map]
  rfl

theorem part_ofFun_eq_part_ofFun_iff {s : ι → β} {i j : ι} :
    (ofFun s).part i = (ofFun s).part j ↔ s i = s j := by
  rw [← (ofFun s).mem_part_iff_part_eq_part (mem_univ i) (mem_univ j), mem_part_ofFun, eq_comm]

/-- Composing the block map of a generated partition with `g` generates the same partition as
composing the generator with `g`. -/
theorem ofFun_part_ofFun_comp (s : ι → β) (g : ι → ι) :
    ofFun ((ofFun s).part ∘ g) = ofFun (s ∘ g) :=
  ofFun_congr fun _ _ ↦ part_ofFun_eq_part_ofFun_iff

/-! ### Relabelling by permutations -/

/-- A permutation `σ` of `ι` relabels a partition of `ι`, moving each block `B` to `σ '' B`. -/
instance : MulAction (Equiv.Perm ι) (Finpartition (univ : Finset ι)) where
  smul σ P := ofFun (P.part ∘ ⇑σ⁻¹)
  one_smul P := by
    show ofFun (P.part ∘ ⇑(1 : Equiv.Perm ι)⁻¹) = P
    simpa using ofFun_part P
  mul_smul σ τ P := by
    show ofFun (P.part ∘ ⇑(σ * τ)⁻¹) = ofFun ((ofFun (P.part ∘ ⇑τ⁻¹)).part ∘ ⇑σ⁻¹)
    rw [ofFun_part_ofFun_comp, mul_inv_rev, Equiv.Perm.coe_mul, Function.comp_assoc]

theorem smul_def (σ : Equiv.Perm ι) (P : Finpartition (univ : Finset ι)) :
    σ • P = ofFun (P.part ∘ ⇑σ⁻¹) := rfl

/-- Precomposing a function with a permutation relabels the partition it generates. -/
theorem ofFun_comp_perm (s : ι → β) (σ : Equiv.Perm ι) : ofFun (s ∘ σ) = σ⁻¹ • ofFun s := by
  rw [smul_def, inv_inv, ofFun_part_ofFun_comp]

/-- Relabelling preserves the block sizes. -/
theorem partSizes_smul (σ : Equiv.Perm ι) (P : Finpartition (univ : Finset ι)) :
    (σ • P).partSizes = P.partSizes := by
  conv_rhs => rw [← ofFun_part P]
  rw [smul_def, partSizes_ofFun, partSizes_ofFun, image_comp, image_univ_equiv]
  congr 1
  funext B
  exact card_equiv σ⁻¹ fun i ↦ by simp

/-! ### Labelling by least elements -/

section Fin

variable {n : ℕ}

/-- The label of `i` in a partition of `Fin n`: the least element of its block. -/
def minLabel (P : Finpartition (univ : Finset (Fin n))) (i : Fin n) : ℕ :=
  (P.part i).min' (P.part_nonempty.2 (mem_univ i))

theorem minLabel_le (P : Finpartition (univ : Finset (Fin n))) (i : Fin n) : P.minLabel i ≤ i :=
  Fin.le_iff_val_le_val.1 (min'_le _ _ (P.mem_part_self.2 (mem_univ i)))

theorem minLabel_eq_of_mem {P : Finpartition (univ : Finset (Fin n))} {i j : Fin n}
    (hj : j ∈ P.part i) (hmin : ∀ k ∈ P.part i, j ≤ k) : P.minLabel i = j :=
  congrArg Fin.val (le_antisymm (min'_le _ _ hj) (le_min' _ _ _ hmin))

/-- A partition of `Fin n` is generated by its labelling by least elements. -/
theorem ofFun_minLabel (P : Finpartition (univ : Finset (Fin n))) : ofFun P.minLabel = P := by
  refine (ofFun_congr fun i j ↦ ⟨fun h ↦ ?_, fun h ↦ by simp only [minLabel, h]⟩).trans
    (ofFun_part P)
  have hi := min'_mem _ (P.part_nonempty.2 (mem_univ i))
  have hj := min'_mem _ (P.part_nonempty.2 (mem_univ j))
  rw [show (P.part i).min' _ = (P.part j).min' _ from Fin.ext h] at hi
  exact P.eq_of_mem_parts (P.part_mem.2 (mem_univ i)) (P.part_mem.2 (mem_univ j)) hi hj

/-- In a sequence of least-element labels, each label is the index where it first occurs. -/
theorem le_of_minLabel_ofFun_eq {s : Fin n → ℕ} (hs : (ofFun s).minLabel = s) (k : Fin n) :
    s k ≤ k ∧ ∃ h : s k < n, s ⟨s k, h⟩ = s k ∧ ∀ k', s k = s k' → s k ≤ k' := by
  have hm := min'_mem _ ((ofFun s).part_nonempty.2 (mem_univ k))
  have hval : ((ofFun s).part k).min' ((ofFun s).part_nonempty.2 (mem_univ k)) = s k :=
    congrFun hs k
  have hle := (ofFun s).minLabel_le k
  rw [congrFun hs k] at hle
  refine ⟨hle, hle.trans_lt k.2, ?_, fun k' hk' ↦ ?_⟩
  · rw [mem_part_ofFun] at hm
    convert hm.symm using 2
    exact Fin.ext hval.symm
  · rw [← hval]
    exact Fin.le_iff_val_le_val.1 (min'_le _ _ (mem_part_ofFun.2 hk'))

/-- Appending an earlier label, or the next index, to a sequence of least-element labels gives a
sequence of least-element labels. -/
theorem minLabel_ofFun_snoc {s : Fin n → ℕ} (hs : (ofFun s).minLabel = s) {c : ℕ}
    (hc : c ∈ univ.image s ∨ c = n) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → ℕ)).minLabel = Fin.snoc s c := by
  have hv := le_of_minLabel_ofFun_eq hs
  funext i
  cases i using Fin.lastCases with
  | last =>
    rw [Fin.snoc_last]
    obtain hc | hc := hc
    · obtain ⟨k₀, -, rfl⟩ := mem_image.1 hc
      obtain ⟨-, hlt, hfix, hmin⟩ := hv k₀
      refine minLabel_eq_of_mem (j := Fin.castSucc ⟨s k₀, hlt⟩) ?_ fun k hk ↦ ?_
      · rw [mem_part_ofFun, Fin.snoc_last, Fin.snoc_castSucc, hfix]
      · rw [mem_part_ofFun] at hk
        cases k using Fin.lastCases with
        | last => exact Fin.le_last _
        | cast k => simpa [Fin.le_iff_val_le_val] using hmin k (by simpa using hk)
    · subst c
      refine minLabel_eq_of_mem (j := Fin.last n) ((ofFun _).mem_part_self.2 (mem_univ _))
        fun k hk ↦ ?_
      rw [mem_part_ofFun] at hk
      cases k using Fin.lastCases with
      | last => exact le_rfl
      | cast k =>
        simp only [Fin.snoc_last, Fin.snoc_castSucc] at hk
        exact absurd ((hv k).1.trans_lt k.2) (by omega)
  | cast k =>
    rw [Fin.snoc_castSucc]
    obtain ⟨-, hlt, hfix, hmin⟩ := hv k
    refine minLabel_eq_of_mem (j := Fin.castSucc ⟨s k, hlt⟩) ?_ fun k' hk' ↦ ?_
    · rw [mem_part_ofFun, Fin.snoc_castSucc, Fin.snoc_castSucc, hfix]
    · rw [mem_part_ofFun] at hk'
      cases k' using Fin.lastCases with
      | last => exact Fin.le_last _
      | cast k' => simpa [Fin.le_iff_val_le_val] using hmin k' (by simpa using hk')

/-- A sequence of least-element labels stays one when its last entry is removed, and its last
entry is an earlier label or the next index. -/
theorem minLabel_ofFun_of_snoc {s : Fin n → ℕ} {c : ℕ}
    (hs : (ofFun (Fin.snoc s c : Fin (n + 1) → ℕ)).minLabel = Fin.snoc s c) :
    (ofFun s).minLabel = s ∧ (c ∈ univ.image s ∨ c = n) := by
  have hv := le_of_minLabel_ofFun_eq hs
  constructor
  · funext k
    obtain ⟨hle, hlt', hfix, hmin⟩ := hv k.castSucc
    simp only [Fin.snoc_castSucc, Fin.val_castSucc] at hle hlt' hfix hmin
    have hlt : s k < n := hle.trans_lt k.2
    refine minLabel_eq_of_mem (j := ⟨s k, hlt⟩) ?_ fun k' hk' ↦ ?_
    · rw [mem_part_ofFun]
      rw [show (⟨s k, _⟩ : Fin (n + 1)) = Fin.castSucc ⟨s k, hlt⟩ from rfl,
        Fin.snoc_castSucc] at hfix
      exact hfix.symm
    · rw [mem_part_ofFun] at hk'
      simpa [Fin.le_iff_val_le_val] using hmin k'.castSucc (by simpa using hk')
  · obtain ⟨hle, hlt, hfix, -⟩ := hv (Fin.last n)
    simp only [Fin.snoc_last, Fin.val_last] at hle hlt hfix
    obtain hcn | rfl := hle.lt_or_eq
    · left
      rw [show (⟨c, hlt⟩ : Fin (n + 1)) = Fin.castSucc ⟨c, hcn⟩ from rfl,
        Fin.snoc_castSucc] at hfix
      exact mem_image.2 ⟨_, mem_univ _, hfix⟩
    · exact Or.inr rfl

variable {β : Type*} [DecidableEq β]

theorem image_snoc (s : Fin n → β) (c : β) :
    univ.image (Fin.snoc s c : Fin (n + 1) → β) = insert c (univ.image s) := by
  ext v
  simp [Fin.exists_fin_succ', eq_comm, or_comm]

theorem card_filter_snoc (s : Fin n → β) (c v : β) :
    #{i | (Fin.snoc s c : Fin (n + 1) → β) i = v} = #{i | s i = v} + if c = v then 1 else 0 := by
  rw [card_filter, card_filter, Fin.sum_univ_castSucc]
  simp only [Fin.snoc_castSucc, Fin.snoc_last]

/-- Appending a new value adds a block of size one. -/
theorem partSizes_ofFun_snoc_of_notMem {s : Fin n → β} {c : β} (hc : c ∉ univ.image s) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → β)).partSizes = 1 ::ₘ (ofFun s).partSizes := by
  have h0 : #{i | s i = c} = 0 := card_eq_zero.2 (filter_eq_empty_iff.2 fun i _ h ↦
    hc (mem_image.2 ⟨i, mem_univ _, h⟩))
  rw [partSizes_ofFun, partSizes_ofFun, image_snoc, insert_val_of_notMem hc, Multiset.map_cons,
    card_filter_snoc]
  simp only [↓reduceIte, h0, zero_add]
  congr 1
  refine Multiset.map_congr rfl fun v hv ↦ ?_
  have hcv : c ≠ v := fun h ↦ hc (by rw [h]; exact hv)
  simp [card_filter_snoc, hcv]

/-- Appending an existing value enlarges its block by one. -/
theorem partSizes_ofFun_snoc_of_mem {s : Fin n → β} {c : β} (hc : c ∈ univ.image s) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → β)).partSizes =
      (#{i | s i = c} + 1) ::ₘ (ofFun s).partSizes.erase #{i | s i = c} := by
  rw [partSizes_ofFun, partSizes_ofFun, image_snoc, insert_eq_of_mem hc]
  have hcv : c ∈ (univ.image s).val := hc
  have hrest : ((univ.image s).val.erase c).map
      (fun v ↦ #{i | (Fin.snoc s c : Fin (n + 1) → β) i = v}) =
      ((univ.image s).val.erase c).map fun v ↦ #{i | s i = v} :=
    Multiset.map_congr rfl fun v hv ↦ by
      have hne : c ≠ v := by
        rintro rfl
        exact (univ.image s).nodup.notMem_erase hv
      simp [card_filter_snoc, hne]
  conv_lhs => rw [← Multiset.cons_erase hcv]
  rw [Multiset.map_cons, hrest, Multiset.map_erase_of_mem _ _ hcv, card_filter_snoc]
  simp

end Fin

end Finpartition
