module

public import Linglib.Syntax.Command
public import Linglib.Syntax.Cat
public import Linglib.Syntax.Tree.Basic

/-!
# Command relations generated by categories

On a labelled tree, the positions whose category lies in a set `L` generate a command relation.
MAX-command is generated by the maximal projections and Langacker's S-command by the S nodes, as
Barker and Pullum reconstruct them. Replacing the subtree at a position leaves what the positions
outside it c-command (`Syntax.CCommands`) unchanged, and the positions of the replacement are
c-commanded by what c-commanded the replaced root (`cCommands_replaceAt_of_le`), the
configuration of reconstruction.

## References

* [barker-pullum-1990]
* [langacker-1969]
* [reinhart-1976]
-/

@[expose] public section

namespace Syntax.Tree

open Core.Order

section Labeled

variable {C W : Type*} (t : Tree C W)

/-- `labeled t L` is the set of positions of `t` whose category lies in `L`. -/
def labeled (L : Set C) : Set TreePath :=
  {p | ∃ s, t.subtreeAt p.toList = some s ∧ Tree.cat s ∈ L}

instance (L : Set C) [DecidablePred (· ∈ L)] (p : TreePath) : Decidable (p ∈ labeled t L) :=
  match h : t.subtreeAt p.toList with
  | none => isFalse (by rintro ⟨s, hs, _⟩; rw [h] at hs; simp at hs)
  | some s => decidable_of_iff (Tree.cat s ∈ L)
      ⟨fun hL ↦ ⟨s, h, hL⟩, fun ⟨_, hs, hL⟩ ↦ by rw [h] at hs; cases hs; exact hL⟩

theorem labeled_union (L₁ L₂ : Set C) : labeled t (L₁ ∪ L₂) = labeled t L₁ ∪ labeled t L₂ := by
  ext p; simp only [labeled, Set.mem_union, Set.mem_ofPred_eq, and_or_left, exists_or]

/-- MAX-command is generated by the maximal projections `max`. -/
abbrev maxCommand (max : Set C) : Set (TreePath × TreePath) :=
  commandRelation (labeled t max)

end Labeled

/-- Langacker's command is generated by the S nodes. -/
abbrev sCommand {W : Type*} (t : Tree Cat W) : Set (TreePath × TreePath) :=
  commandRelation (labeled t {.S})

section Replace

variable {C W : Type*} {t new : Tree C W} {a b c : TreePath}

/-- Replacing the subtree at `c` leaves the branching positions outside it as they were. -/
theorem isBranchingAt_replaceAt {x : TreePath} (h : ¬ c ≤ x) :
    IsBranchingAt (t.replaceAt c.toList new) x ↔ IsBranchingAt t x := by
  obtain ⟨c⟩ := c
  obtain ⟨x⟩ := x
  induction c generalizing t x with
  | nil => exact absurd (TreePath.le_def.2 List.nil_prefix) h
  | cons i c ih =>
    cases x with
    | nil =>
      rcases t with ⟨l, cs⟩
      simp [IsBranchingAt, RoseTree.replaceAt_cons]
    | cons j x =>
      simp only [IsBranchingAt, RoseTree.subtreeAt_cons, RoseTree.children_replaceAt_cons,
        List.getElem?_modify]
      rcases eq_or_ne i j with rfl | hij
      · have h' : ¬ (⟨c⟩ : TreePath) ≤ ⟨x⟩ := fun hc ↦ h (by simpa [TreePath.le_def] using hc)
        cases t.children[i]? with
        | none => simp
        | some s => simpa [IsBranchingAt] using ih (t := s) x h'
      · simp [hij]

/-- Unless `c` lies properly above `a`, what `a` c-commands is unchanged by replacing the subtree
at `c`. -/
theorem mem_cCommandAt_replaceAt (h : ¬ c < a) (b : TreePath) :
    (a, b) ∈ cCommandAt (t.replaceAt c.toList new) ↔ (a, b) ∈ cCommandAt t :=
  mem_commandRelation_congr (fun _ hxa ↦ isBranchingAt_replaceAt fun hcx ↦ h (hcx.trans_lt hxa)) b

/-- A position outside the subtree at `c` c-commands a position of its replacement exactly when it
c-commands `c`. -/
theorem cCommands_replaceAt_of_le (hcb : c ≤ b) (hca : ¬ c ≤ a) (hac : ¬ a ≤ c) :
    CCommands (t.replaceAt c.toList new) a b ↔ CCommands t a c := by
  have hlt : ¬ c < a := fun h ↦ hca h.le
  have hab : ¬ a ≤ b := fun h ↦ (IsLeftLinear.comparable_of_le_common h hcb).elim hac hca
  have hba : ¬ b ≤ a := fun h ↦ hca (hcb.trans h)
  simp only [CCommands, mem_commandRelation_iff_of_le hcb hlt, mem_cCommandAt_replaceAt hlt, hab,
    hba, hac, hca, not_false_eq_true, and_true]

/-- The root of the replacement c-commands what the replaced subtree c-commanded. -/
theorem cCommands_replaceAt_self : CCommands (t.replaceAt c.toList new) c a ↔ CCommands t c a := by
  simp only [CCommands, mem_cCommandAt_replaceAt (lt_irrefl c)]

end Replace

end Syntax.Tree
