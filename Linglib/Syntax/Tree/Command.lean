module

public import Linglib.Syntax.Command
public import Linglib.Syntax.Cat
public import Linglib.Syntax.Tree.Basic

/-!
# Command relations generated by categories

On a labelled tree, the positions whose category lies in a set `L` generate a command relation,
as Langacker's S-command is generated by the S nodes in Barker and Pullum's reconstruction.
MAX-command, generated by the maximal projections, is read off the tree's heads
(`PhraseStructure.Tree.maxCommandAt`).

## References

* [barker-pullum-1990]
* [langacker-1969]
-/

@[expose] public section

namespace PhraseStructure.Tree

open Core.Order

/-- `labeled t L` is the set of positions of `t` whose category lies in `L`. -/
abbrev labeled {C W : Type*} (t : Tree C W) (L : Set C) : Set TreePath :=
  RoseTree.positionsWhere (fun s ↦ s.value.cat ∈ L) t

/-- Langacker's command is generated by the S nodes. -/
abbrev sCommand {W : Type*} (t : Tree Cat W) : Set (TreePath × TreePath) :=
  commandRelation (labeled t {.S})

end PhraseStructure.Tree
