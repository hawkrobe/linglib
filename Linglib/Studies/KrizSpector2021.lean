import Linglib.Semantics.Homogeneity.Plural
import Linglib.Semantics.Homogeneity.Collective
import Mathlib.Data.Finset.Interval
import Mathlib.Data.Fintype.Powerset

/-!
# Križ and Spector (2021): Interpreting Plural Predication

This file formalizes [kriz-spector-2021]'s account of homogeneity and non-maximality. A
sentence with a plural definite is underspecified between a family of candidate
interpretations: the definite is read as an existential quantifier over a convex set of
pluralities generated by some parts of its denotation `x` together with `x` itself
(`Cand`, the paper's (21)). The sentence is true when every candidate is true, false when
every candidate is false, and undefined otherwise (`TrueOnAll`, `FalseOnAll`); on a
distributive predicate this is the library's trivalent plural value (`value_reading_star`).
Non-maximality comes from pragmatics: only the candidates strongly relevant to the current
issue count (`TrueOnRelevant`), so that under an issue that lumps reading eight books with
reading all of them, *Mary read the books* conveys that she read at least eight
(`trueOnRelevant_reading`) and its negation that she read fewer than three
(`trueOnRelevant_not_reading`).

The compositional half of the paper interprets predicates relative to a homogeneity
parameter `HParam` assigning a candidate domain to every argument index and plurality, and
treats *all* as universal quantification over the parameters that differ from the current
one only at its indices (`all`, the paper's (71)). This removes homogeneity and
non-maximality on the associated argument while leaving other arguments alone
(`all_pred`, `all_pred₂`), makes *the girls all didn't dance* mean that no girl danced
(`all_not_pred`), renders floating *all* vacuous under a quantifier that already
neutralizes the parameter (`all_all`), collapses coordinated predicates to the strong
reading (`all_and`), and does not reach a pronoun bound by its associate
(`all_binding`). The set of candidate interpretations is the same whether negation scopes
above or below the distributivity operator (`interpretations_not_dist`, the paper's
footnote proof by disjunctive normal form).

The comparison with [kriz-2016] is the paper's own (§4): Križ's Addressing condition has
strong relevance as its special case on bivalent propositions
(`addressesIssue_iff_stronglyRelevant`), and on the exam issue of the paper's (36) Križ's
account communicates that Mary passed while no candidate is strongly relevant on the
present account (`communicatedContent_solvedMath`, `not_felicitous_solvedMath`). The
appendix's candidates with superpluralities (`CandUp`) yield the upward-homogeneity falsity
condition and coincide with Križ's generalised homogeneity (`valueUp_eq_generalisedTruthValue`).

## Implementation notes

Pluralities are `Finset Atom` ordered by inclusion, so parts are nonempty subsets, the
convex closure of (21) is a union of `Finset.Icc` intervals, and candidate domains are
finite. A candidate interpretation is presented by its domain; `reading D P` is the
existential quantifier over `D` applied to the predicate `P` on pluralities. Sentence
frames take the domain as an argument (`TrueOnAll x φ`), which covers negation and
non-monotonic embeddings such as the paper's (22). Strong relevance is the substrate's
`Homogeneity.isStronglyRelevantProp`, constancy on the cells of the issue, the paper's
gloss of (25). The reading-list example (26)–(28) is stated for any thresholds
`0 < lo ≤ hi ≤ |books|` in place of the paper's 3, 8, and 10.

## TODO

* The paper's §2.2 critique of [malamud-2012] and its §6 open problems (functional
  non-maximality, overt questions) are not formalized.
* The appendix's revision of *all* in terms of maximal individual witnesses, (117)–(119),
  is not formalized; `CandUp` covers only the candidate side of the appendix.

## References

* [kriz-spector-2021]
* [kriz-2016]
* [kriz-chemla-2015]
* [krifka-1996]
* [malamud-2012]
-/

namespace KrizSpector2021

open Homogeneity Plurality Plurality.Trivalent
open Trivalent (Prop3)

variable {Atom W : Type*} [DecidableEq Atom]

/-! ### Candidate denotations (§3.1) -/

/-- The nonempty mereological parts of a plurality. -/
abbrev parts (x : Finset Atom) : Finset (Finset Atom) := Finset.Ioc ⊥ x

theorem mem_parts {x z : Finset Atom} : z ∈ parts x ↔ z.Nonempty ∧ z ⊆ x := by
  simp [parts, Finset.mem_Ioc, Finset.empty_ssubset]

/-- The convex closure of a set of pluralities: everything in between two of its members,
the paper's (21). -/
def conv (A : Finset (Finset Atom)) : Finset (Finset Atom) :=
  A.biUnion λ a => A.biUnion λ b => Finset.Icc a b

theorem mem_conv {A : Finset (Finset Atom)} {z : Finset Atom} :
    z ∈ conv A ↔ ∃ a ∈ A, ∃ b ∈ A, a ⊆ z ∧ z ⊆ b := by
  simp [conv, Finset.mem_Icc]

theorem mem_conv_insert {x : Finset Atom} {S : Finset (Finset Atom)} (hS : S ⊆ parts x)
    {z : Finset Atom} : z ∈ conv (insert x S) ↔ z ⊆ x ∧ ∃ s ∈ insert x S, s ⊆ z := by
  rw [mem_conv]
  constructor
  · rintro ⟨a, ha, b, hb, haz, hzb⟩
    refine ⟨hzb.trans ?_, a, ha, haz⟩
    rcases Finset.mem_insert.1 hb with rfl | hb
    · exact Finset.Subset.refl _
    · exact (mem_parts.1 (hS hb)).2
  · rintro ⟨hzx, s, hs, hsz⟩
    exact ⟨s, hs, x, Finset.mem_insert_self x S, hsz, hzx⟩

/-- The candidate denotations of `x`, the paper's (21): the existential quantifiers over the
convex closure of a set of parts of `x` together with `x`, presented by their domains. -/
def Cand (x : Finset Atom) : Finset (Finset (Finset Atom)) :=
  (parts x).powerset.image λ S => conv (insert x S)

theorem mem_Cand {x : Finset Atom} {D : Finset (Finset Atom)} :
    D ∈ Cand x ↔ ∃ S, S ⊆ parts x ∧ conv (insert x S) = D := by
  simp [Cand]

/-- Every candidate is entailed by the universal one: `x` lies in every domain. -/
theorem self_mem_of_mem_Cand {x : Finset Atom} {D : Finset (Finset Atom)} (hD : D ∈ Cand x) :
    x ∈ D := by
  obtain ⟨S, hS, rfl⟩ := mem_Cand.1 hD
  exact (mem_conv_insert hS).2 ⟨Finset.Subset.refl _, x, Finset.mem_insert_self _ _,
    Finset.Subset.refl _⟩

theorem mem_parts_of_mem_Cand {x : Finset Atom} (hx : x.Nonempty) {D : Finset (Finset Atom)}
    (hD : D ∈ Cand x) {z : Finset Atom} (hz : z ∈ D) : z ∈ parts x := by
  obtain ⟨S, hS, rfl⟩ := mem_Cand.1 hD
  obtain ⟨hzx, s, hs, hsz⟩ := (mem_conv_insert hS).1 hz
  refine mem_parts.2 ⟨?_, hzx⟩
  rcases Finset.mem_insert.1 hs with rfl | hs
  · exact hx.mono hsz
  · exact (mem_parts.1 (hS hs)).1.mono hsz

/-- The universal candidate, from the empty set of parts. -/
theorem singleton_mem_Cand (x : Finset Atom) : {x} ∈ Cand x := by
  refine mem_Cand.2 ⟨∅, Finset.empty_subset _, ?_⟩
  ext z
  rw [mem_conv_insert (Finset.empty_subset _), Finset.insert_empty, Finset.mem_singleton]
  constructor
  · rintro ⟨hzx, s, hs, hsz⟩
    rw [Finset.mem_singleton] at hs
    exact Finset.Subset.antisymm hzx (hs ▸ hsz)
  · rintro rfl
    exact ⟨Finset.Subset.refl _, z, Finset.mem_singleton_self _, Finset.Subset.refl _⟩

/-- The existential candidate, from all the parts. -/
theorem parts_mem_Cand {x : Finset Atom} (hx : x.Nonempty) : parts x ∈ Cand x := by
  refine mem_Cand.2 ⟨parts x, Finset.Subset.refl _, ?_⟩
  ext z
  rw [mem_conv_insert (Finset.Subset.refl _), mem_parts]
  constructor
  · rintro ⟨hzx, s, hs, hsz⟩
    refine ⟨?_, hzx⟩
    rcases Finset.mem_insert.1 hs with rfl | hs
    · exact hx.mono hsz
    · exact (mem_parts.1 hs).1.mono hsz
  · rintro ⟨hz, hzx⟩
    exact ⟨hzx, z, Finset.mem_insert_of_mem (mem_parts.2 ⟨hz, hzx⟩), Finset.Subset.refl _⟩

/-- The two candidates of [krifka-1996], the universal and the existential reading (§2.1). -/
def twoCand (x : Finset Atom) : Finset (Finset (Finset Atom)) := {{x}, parts x}

theorem twoCand_subset_Cand {x : Finset Atom} (hx : x.Nonempty) : twoCand x ⊆ Cand x := by
  intro D hD
  rcases Finset.mem_insert.1 hD with rfl | hD
  · exact singleton_mem_Cand x
  · exact Finset.mem_singleton.1 hD ▸ parts_mem_Cand hx

/-! ### Truth on all readings (§2.1, §3.1) -/

/-- The reading of the predicate `P` on pluralities under the candidate domain `D`: some
member of `D` satisfies `P`. -/
def reading (D : Finset (Finset Atom)) (P : Finset Atom → W → Prop) (w : W) : Prop :=
  ∃ z ∈ D, P z w

instance (D : Finset (Finset Atom)) (P : Finset Atom → W → Prop) [∀ z w, Decidable (P z w)]
    (w : W) : Decidable (reading D P w) :=
  inferInstanceAs (Decidable (∃ z ∈ D, P z w))

/-- A sentence frame `φ` sends the candidate domain chosen for the plural definite to the
resulting candidate interpretation. The sentence is true when every candidate is. -/
def TrueOnAll (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop) (w : W) : Prop :=
  ∀ D ∈ Cand x, φ D w

/-- The sentence is false when every candidate is. -/
def FalseOnAll (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop) (w : W) : Prop :=
  ∀ D ∈ Cand x, ¬ φ D w

instance (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop) [∀ D w, Decidable (φ D w)]
    (w : W) : Decidable (TrueOnAll x φ w) :=
  inferInstanceAs (Decidable (∀ D ∈ Cand x, φ D w))

instance (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop) [∀ D w, Decidable (φ D w)]
    (w : W) : Decidable (FalseOnAll x φ w) :=
  inferInstanceAs (Decidable (∀ D ∈ Cand x, ¬ φ D w))

/-- The trivalent value of the sentence: true, false, or undefined on its candidates. -/
def value (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop) [∀ D w, Decidable (φ D w)]
    (w : W) : Trivalent :=
  if TrueOnAll x φ w then .true else if FalseOnAll x φ w then .false else .indet

/-- Negating the sentence negates its candidates: falsity on all readings of `φ` is truth on
all readings of `¬ φ`, the paper's (61)–(62). -/
theorem falseOnAll_iff_trueOnAll_not (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop)
    (w : W) : FalseOnAll x φ w ↔ TrueOnAll x (λ D w => ¬ φ D w) w :=
  Iff.rfl

/-- Plural predication is true on all readings iff the predicate holds of the whole
plurality. -/
theorem trueOnAll_reading (x : Finset Atom) (P : Finset Atom → W → Prop) (w : W) :
    TrueOnAll x (reading · P) w ↔ P x w := by
  constructor
  · intro h
    obtain ⟨z, hz, hP⟩ := h {x} (singleton_mem_Cand x)
    exact Finset.mem_singleton.1 hz ▸ hP
  · exact λ h D hD => ⟨x, self_mem_of_mem_Cand hD, h⟩

/-- Plural predication is false on all readings iff the predicate fails of every part. -/
theorem falseOnAll_reading {x : Finset Atom} (hx : x.Nonempty) (P : Finset Atom → W → Prop)
    (w : W) : FalseOnAll x (reading · P) w ↔ ∀ z ∈ parts x, ¬ P z w := by
  constructor
  · exact λ h z hz hP => h _ (parts_mem_Cand hx) ⟨z, hz, hP⟩
  · exact λ h D hD ⟨z, hz, hP⟩ => h z (mem_parts_of_mem_Cand hx hD hz) hP

/-- The distributive predicate on pluralities generated by a predicate on atoms, the
meta-language distributivity operator of the paper's (63a). -/
def star (Q : Atom → W → Prop) : Finset Atom → W → Prop := λ z w => ∀ a ∈ z, Q a w

instance (Q : Atom → W → Prop) [∀ a w, Decidable (Q a w)] (z : Finset Atom) (w : W) :
    Decidable (star Q z w) :=
  inferInstanceAs (Decidable (∀ a ∈ z, Q a w))

omit [DecidableEq Atom] in
theorem star_antitone (Q : Atom → W → Prop) {z z' : Finset Atom} (h : z' ⊆ z) {w : W}
    (hz : star Q z w) : star Q z' w :=
  λ a ha => hz a (h ha)

/-- On a distributive predicate, truth on all readings is the library's trivalent plural
value: true when every atom satisfies the predicate, false when none does. -/
theorem value_reading_star {x : Finset Atom} (hx : x.Nonempty) (Q : Atom → W → Prop)
    [∀ a w, Decidable (Q a w)] (w : W) :
    value x (reading · (star Q)) w = pluralTruthValue Q x w := by
  have ht : TrueOnAll x (reading · (star Q)) w ↔ allSatisfy Q x w := trueOnAll_reading _ _ _
  have hf : FalseOnAll x (reading · (star Q)) w ↔ noneSatisfy Q x w := by
    rw [falseOnAll_reading hx]
    constructor
    · intro h a ha hQ
      refine h {a} (mem_parts.2 ⟨Finset.singleton_nonempty a, Finset.singleton_subset_iff.2 ha⟩)
        λ b hb => ?_
      rw [Finset.mem_singleton.1 hb]
      exact hQ
    · intro h z hz hQ
      obtain ⟨a, ha⟩ := (mem_parts.1 hz).1
      exact h a ((mem_parts.1 hz).2 ha) (hQ a ha)
  unfold value
  rcases h : pluralTruthValue Q x w with _ | _ | _
  · rw [pluralTruthValue_eq_true_iff] at h
    exact if_pos (ht.2 h)
  · rw [pluralTruthValue_eq_false_iff] at h
    obtain ⟨a, ha⟩ := hx
    rw [if_neg λ h' => h.2 a ha (ht.1 h' a ha), if_pos (hf.2 h.2)]
  · rw [pluralTruthValue_eq_gap_iff] at h
    obtain ⟨⟨a, ha, hQ⟩, b, hb, hQ'⟩ := h
    rw [if_neg λ h' => hQ' (ht.1 h' b hb), if_neg λ h' => hf.1 h' a ha hQ]

/-! ### Non-monotonic contexts (§3.1)

The paper's (22): Mary read all of the books, Sue read half of them and Peter the other
half. On the two candidates of [krifka-1996], *Exactly two of the students read the books*
is false; the candidate generated by the half Peter read, the paper's (23), is true while
the universal candidate is false, so on the enriched candidate set the sentence is neither
true nor false. -/

section ExactlyTwo

inductive Student where
  | mary
  | sue
  | peter
  deriving DecidableEq

inductive Book where
  | a
  | b
  | c
  | d
  deriving DecidableEq

/-- The books. -/
def books : Finset Book := {.a, .b, .c, .d}

/-- The scenario: which books each student read. -/
def read₀ : Student → Finset Book
  | .mary => {.a, .b, .c, .d}
  | .sue => {.c, .d}
  | .peter => {.a, .b}

/-- *Exactly two of the students read the books* under the candidate domain `D`, at a world
`w` recording which books each student read. -/
def exactlyTwo (D : Finset (Finset Book)) (w : Student → Finset Book) : Prop :=
  (({.mary, .sue, .peter} : Finset Student).filter λ s => reading D (λ z w => z ⊆ w s) w).card
    = 2

instance (D : Finset (Finset Book)) (w : Student → Finset Book) : Decidable (exactlyTwo D w) :=
  inferInstanceAs (Decidable (_ = 2))

/-- Both of Krifka's candidates are false in the scenario. -/
theorem exactlyTwo_twoCand : ∀ D ∈ twoCand books, ¬ exactlyTwo D read₀ := by
  intro D hD
  rcases Finset.mem_insert.1 hD with rfl | hD
  · decide +kernel
  · rw [Finset.mem_singleton.1 hD]
    decide +kernel

/-- The universal candidate is false: only Mary read all the books. -/
theorem exactlyTwo_not_trueOnAll : ¬ TrueOnAll books exactlyTwo read₀ :=
  λ h => (by decide +kernel : ¬ exactlyTwo {books} read₀) (h _ (singleton_mem_Cand books))

/-- The candidate generated by Peter's half is true: exactly two students read a plurality
containing both of those books, the paper's (23). -/
theorem exactlyTwo_not_falseOnAll : ¬ FalseOnAll books exactlyTwo read₀ := by
  intro h
  have hS : ({{.a, .b}} : Finset (Finset Book)) ⊆ parts books := by decide +kernel
  have hD : conv (insert books {{.a, .b}}) ∈ Cand books := mem_Cand.2 ⟨_, hS, rfl⟩
  have hT : exactlyTwo (conv (insert books {{.a, .b}})) read₀ := by decide +kernel
  exact h _ hD hT

theorem value_exactlyTwo : value books exactlyTwo read₀ = .indet := by
  simp [value, exactlyTwo_not_trueOnAll, exactlyTwo_not_falseOnAll]

end ExactlyTwo

/-! ### Strong relevance and non-maximality (§3.2) -/

section Relevance

variable (q : QUD W) (x : Finset Atom) (φ : Finset (Finset Atom) → W → Prop)

/-- The sentence is judged true when every strongly relevant candidate is true. -/
def TrueOnRelevant (w : W) : Prop :=
  ∀ D ∈ Cand x, isStronglyRelevantProp q (φ D) → φ D w

/-- The sentence is judged false when every strongly relevant candidate is false. -/
def FalseOnRelevant (w : W) : Prop :=
  ∀ D ∈ Cand x, isStronglyRelevantProp q (φ D) → ¬ φ D w

/-- Felicity requires some strongly relevant candidate (the paper's fn. 17). -/
def Felicitous : Prop := ∃ D ∈ Cand x, isStronglyRelevantProp q (φ D)

/-- Without a strongly relevant candidate the sentence is judged both true and false. -/
theorem trueOnRelevant_and_falseOnRelevant_iff (w : W) :
    TrueOnRelevant q x φ w ∧ FalseOnRelevant q x φ w ↔ ¬ Felicitous q x φ := by
  constructor
  · rintro ⟨ht, hf⟩ ⟨D, hD, hrel⟩
    exact hf D hD hrel (ht D hD hrel)
  · exact λ h => ⟨λ D hD hrel => absurd ⟨D, hD, hrel⟩ h, λ D hD hrel => absurd ⟨D, hD, hrel⟩ h⟩

/-- Truth on all readings at an issue-equivalent world gives truth on the relevant ones. -/
theorem trueOnRelevant_of_r {w w' : W} (h : q.r w w') (hw' : TrueOnAll x φ w') :
    TrueOnRelevant q x φ w :=
  λ D hD hrel => (hrel w w' h).2 (hw' D hD)

/-- Under a monotone-decreasing predicate the reading generated by a set of parts is the
disjunction over those parts. -/
theorem reading_conv_insert {S : Finset (Finset Atom)} (hS : S ⊆ parts x)
    {P : Finset Atom → W → Prop} {w : W} (hP : ∀ z z', z' ⊆ z → P z w → P z' w) :
    reading (conv (insert x S)) P w ↔ ∃ s ∈ insert x S, P s w := by
  constructor
  · rintro ⟨z, hz, hP'⟩
    obtain ⟨-, s, hs, hsz⟩ := (mem_conv_insert hS).1 hz
    exact ⟨s, hs, hP z s hsz hP'⟩
  · rintro ⟨s, hs, hP'⟩
    refine ⟨s, (mem_conv_insert hS).2 ⟨?_, s, hs, Finset.Subset.refl _⟩, hP'⟩
    rcases Finset.mem_insert.1 hs with rfl | hs
    · exact Finset.Subset.refl _
    · exact (mem_parts.1 (hS hs)).2

end Relevance

/-! ### The reading list (§3.2)

The paper's (26)–(28): reading `hi` or more of the books is as good as reading all of them
and reading fewer than `lo` is as bad as reading none. A world records which books Mary
read. -/

section ReadingList

variable {Book : Type*} [Fintype Book] [DecidableEq Book]

/-- Mary read the plurality `z` at `w` when every book in `z` is among those she read. -/
abbrev readP : Finset Book → Finset Book → Prop := λ z w => z ⊆ w

/-- The issue (26): whether Mary read at least `lo` of the books, and whether at least
`hi`. -/
def issue (lo hi : ℕ) : QUD (Finset Book) :=
  QUD.ofDecEq λ w => (decide (lo ≤ w.card), decide (hi ≤ w.card))

omit [Fintype Book] [DecidableEq Book] in
theorem issue_r (lo hi : ℕ) (w v : Finset Book) :
    (issue lo hi).r w v ↔ (lo ≤ w.card ↔ lo ≤ v.card) ∧ (hi ≤ w.card ↔ hi ≤ v.card) := by
  simp [issue, Prod.ext_iff]

theorem powersetCard_subset_parts {n : ℕ} (hn : 0 < n) :
    Finset.powersetCard n (Finset.univ : Finset Book) ⊆ parts (Finset.univ : Finset Book) := by
  intro s hs
  rw [Finset.mem_powersetCard] at hs
  exact mem_parts.2 ⟨Finset.card_pos.1 (hs.2 ▸ hn), hs.1⟩

/-- The candidate generated by the `n`-element parts reads as *Mary read `n` or more*. -/
theorem reading_powersetCard {n : ℕ} (hn₀ : 0 < n) (hn : n ≤ Fintype.card Book)
    (w : Finset Book) :
    reading (conv (insert Finset.univ (Finset.powersetCard n (Finset.univ : Finset Book))))
      readP w ↔ n ≤ w.card := by
  rw [reading_conv_insert Finset.univ (powersetCard_subset_parts hn₀) (λ _ _ h hz => h.trans hz)]
  constructor
  · rintro ⟨s, hs, hsw⟩
    rcases Finset.mem_insert.1 hs with rfl | hs
    · exact hn.trans (Finset.card_univ (α := Book) ▸ Finset.card_le_card hsw)
    · exact (Finset.mem_powersetCard.1 hs).2 ▸ Finset.card_le_card hsw
  · intro h
    obtain ⟨s, hsw, hs⟩ := Finset.exists_subset_card_eq h
    exact ⟨s, Finset.mem_insert_of_mem (Finset.mem_powersetCard.2 ⟨Finset.subset_univ _, hs⟩),
      hsw⟩

theorem stronglyRelevant_powersetCard {lo hi n : ℕ} (hn₀ : 0 < n) (hn : n ≤ Fintype.card Book)
    (h : n = lo ∨ n = hi) :
    isStronglyRelevantProp (issue lo hi)
      (reading (conv (insert Finset.univ (Finset.powersetCard n (Finset.univ : Finset Book))))
        readP) := by
  intro w v hwv
  rw [reading_powersetCard hn₀ hn, reading_powersetCard hn₀ hn]
  rcases h with rfl | rfl
  · exact ((issue_r _ _ _ _).1 hwv).1
  · exact ((issue_r _ _ _ _).1 hwv).2

/-- *Mary read the books*, judged on its strongly relevant candidates, conveys that she read
`hi` or more of them, the paper's (27). -/
theorem trueOnRelevant_reading {lo hi : ℕ} (h₀ : 0 < lo) (hlh : lo ≤ hi)
    (hhi : hi ≤ Fintype.card Book) (w : Finset Book) :
    TrueOnRelevant (issue lo hi) (Finset.univ : Finset Book) (reading · readP) w ↔
      hi ≤ w.card := by
  constructor
  · intro h
    rw [← reading_powersetCard (h₀.trans_le hlh) hhi]
    exact h _ (mem_Cand.2 ⟨_, powersetCard_subset_parts (h₀.trans_le hlh), rfl⟩)
      (stronglyRelevant_powersetCard (h₀.trans_le hlh) hhi (Or.inr rfl))
  · intro h
    refine trueOnRelevant_of_r _ _ _ (w' := Finset.univ) ?_
      ((trueOnAll_reading _ _ _).2 (Finset.Subset.refl _))
    rw [issue_r, Finset.card_univ]
    exact ⟨iff_of_true (hlh.trans h) (hlh.trans hhi), iff_of_true h hhi⟩

/-- *Mary didn't read the books* conveys that she read fewer than `lo` of them, the paper's
(28): the negated candidates that are strongly relevant are the negations of the relevant
ones, and their conjunction is the bottom cell. -/
theorem trueOnRelevant_not_reading {lo hi : ℕ} (h₀ : 0 < lo) (hlh : lo ≤ hi)
    (hhi : hi ≤ Fintype.card Book) (w : Finset Book) :
    TrueOnRelevant (issue lo hi) (Finset.univ : Finset Book) (λ D w => ¬ reading D readP w) w ↔
      w.card < lo := by
  have hlo : lo ≤ Fintype.card Book := hlh.trans hhi
  constructor
  · intro h
    rw [← not_le, ← reading_powersetCard h₀ hlo]
    exact h _ (mem_Cand.2 ⟨_, powersetCard_subset_parts h₀, rfl⟩)
      (λ w v hwv => not_congr (stronglyRelevant_powersetCard h₀ hlo (Or.inl rfl) w v hwv))
  · intro h
    have hne : (Finset.univ : Finset Book).Nonempty :=
      Finset.univ_nonempty_iff.2 (Fintype.card_pos_iff.1 (h₀.trans_le hlo))
    refine trueOnRelevant_of_r _ _ _ (w' := ∅) ?_ ?_
    · rw [issue_r, Finset.card_empty]
      exact ⟨iff_of_false (not_le.2 h) (not_le.2 h₀),
        iff_of_false (not_le.2 (h.trans_le hlh)) (not_le.2 (h₀.trans_le hlh))⟩
    · show FalseOnAll Finset.univ (reading · readP) ∅
      rw [falseOnAll_reading hne]
      intro z hz hsub
      exact (mem_parts.1 hz).1.ne_empty (Finset.subset_empty.1 hsub)

end ReadingList

/-! ### Comparison with Križ (2016) (§4) -/

/-- Križ's Addressing condition, the paper's (34a), has strong relevance as its special case
on bivalent propositions. -/
theorem addressesIssue_iff_stronglyRelevant {S : Prop3 W} (hbiv : S.isBivalent) (q : QUD W) :
    addressesIssue q S ↔ isStronglyRelevantProp q (· ∈ S.posExt) := by
  constructor
  · intro h w₁ w₂ hr
    show S w₁ = .true ↔ S w₂ = .true
    constructor
    · intro h₁
      exact (hbiv w₂).resolve_right λ h₂ => h ⟨w₁, w₂, hr, h₁, h₂⟩
    · intro h₂
      exact (hbiv w₁).resolve_right λ h₁ => h ⟨w₂, w₁, q.iseqv.symm hr, h₂, h₁⟩
  · rintro h ⟨w₁, w₂, hr, h₁, h₂⟩
    have h₂' : S w₂ = .true := (h w₁ w₂ hr).1 h₁
    simp [h₂] at h₂'

/-! The paper's (36): to pass, Mary must solve all of the math problems, or some of them and
a physics problem, and the issue is whether she passed. On Križ's account *Mary solved the
math problems* addresses the issue and communicates that she passed; on the present account
no candidate is strongly relevant, so the sentence cannot address this issue at all. -/

section Exam

variable {Math : Type*} [Fintype Math] [DecidableEq Math]

/-- A world: the math problems Mary solved, and whether she solved a physics problem. -/
abbrev ExamWorld (Math : Type*) := Finset Math × Bool

/-- Passing: all of the math problems, or some of them and a physics problem. -/
def Pass (w : ExamWorld Math) : Prop := w.1 = Finset.univ ∨ (w.1.Nonempty ∧ w.2 = true)

instance (w : ExamWorld Math) : Decidable (Pass w) :=
  inferInstanceAs (Decidable (_ ∨ _))

/-- The issue: whether Mary passed. -/
def passFail : QUD (ExamWorld Math) := QUD.ofDecEq λ w => decide (Pass w)

theorem passFail_r (w v : ExamWorld Math) : (passFail).r w v ↔ (Pass w ↔ Pass v) := by
  simp [passFail]

/-- *Mary solved the math problems* as Križ's trivalent sentence. -/
def solvedMath : Prop3 (ExamWorld Math) := barePlural (λ m w => m ∈ w.1) Finset.univ

theorem solvedMath_eq_true_iff (w : ExamWorld Math) :
    solvedMath w = .true ↔ w.1 = Finset.univ := by
  simp [solvedMath, barePlural, allSatisfy, distMaximal, Finset.eq_univ_iff_forall]

theorem solvedMath_eq_false_iff [Nonempty Math] (w : ExamWorld Math) :
    solvedMath w = .false ↔ w.1 = ∅ := by
  simp [solvedMath, barePlural, noneSatisfy, Finset.eq_empty_iff_forall_notMem]

/-- Križ's sentence addresses the pass/fail issue: its true worlds pass and its false worlds
fail. -/
theorem addressesIssue_solvedMath [Nonempty Math] :
    addressesIssue passFail (solvedMath (Math := Math)) := by
  rintro ⟨w₁, w₂, hr, h₁, h₂⟩
  rw [solvedMath_eq_true_iff] at h₁
  rw [solvedMath_eq_false_iff] at h₂
  have hp : Pass w₂ := ((passFail_r w₁ w₂).1 hr).1 (Or.inl h₁)
  rcases hp with hp | hp
  · exact Finset.univ_nonempty.ne_empty (hp ▸ h₂)
  · exact hp.1.ne_empty h₂

/-- On Križ's account the sentence communicates that Mary passed. -/
theorem communicatedContent_solvedMath [Nonempty Math] :
    communicatedContent passFail (solvedMath (Math := Math)) = {w | Pass w} := by
  ext w
  simp only [mem_communicatedContent, sufficientlyTrue, Set.mem_ofPred_eq, passFail_r,
    solvedMath_eq_true_iff]
  constructor
  · rintro ⟨w', hr, h⟩
    exact hr.2 (Or.inl h)
  · intro h
    exact ⟨(Finset.univ, w.2), iff_of_true h (Or.inl rfl), rfl⟩

/-- On the present account no candidate interpretation is strongly relevant to the pass/fail
issue: the universal candidate splits the passing worlds, and any other candidate splits the
failing ones. -/
theorem not_felicitous_solvedMath (h : 1 < Fintype.card Math) :
    ¬ Felicitous passFail (Finset.univ : Finset Math)
      (reading · λ z (w : ExamWorld Math) => z ⊆ w.1) := by
  have hne : (Finset.univ : Finset Math).Nonempty :=
    Finset.univ_nonempty_iff.2 (Fintype.card_pos_iff.1 (Nat.zero_lt_one.trans h))
  rintro ⟨D, hD, hrel⟩
  obtain ⟨S, hS, rfl⟩ := mem_Cand.1 hD
  have key : ∀ w : ExamWorld Math,
      reading (conv (insert Finset.univ S)) (λ z w => z ⊆ w.1) w ↔
        ∃ s ∈ insert Finset.univ S, s ⊆ w.1 :=
    λ w => reading_conv_insert _ hS λ _ _ h hz => h.trans hz
  by_cases hex : ∃ s ∈ S, s ≠ Finset.univ
  · obtain ⟨s, hs, hsne⟩ := hex
    have hr : passFail.r (s, false) (∅, false) := by
      rw [passFail_r]
      exact iff_of_false (λ hp => hp.elim hsne λ hp => Bool.false_ne_true hp.2)
        (λ hp => hp.elim (λ hp => hne.ne_empty hp.symm) λ hp => hp.1.ne_empty rfl)
    have h₁ : ∃ s' ∈ insert Finset.univ S, s' ⊆ s :=
      ⟨s, Finset.mem_insert_of_mem hs, Finset.Subset.refl _⟩
    obtain ⟨s', hs', hs'e⟩ := (key _).1 ((hrel _ _ hr).1 ((key _).2 h₁))
    have hs'e : s' = ∅ := Finset.subset_empty.1 hs'e
    rcases Finset.mem_insert.1 hs' with rfl | hs'
    · exact hne.ne_empty hs'e
    · exact (mem_parts.1 (hS hs')).1.ne_empty hs'e
  · push Not at hex
    obtain ⟨m₁, m₂, hm⟩ := Fintype.exists_pair_of_one_lt_card h
    have hr : passFail.r (Finset.univ, true) ({m₁}, true) := by
      rw [passFail_r]
      exact iff_of_true (Or.inl rfl) (Or.inr ⟨Finset.singleton_nonempty _, rfl⟩)
    obtain ⟨s, hs, hse⟩ := (key _).1 ((hrel _ _ hr).1 ((key _).2
      ⟨Finset.univ, Finset.mem_insert_self _ _, Finset.Subset.refl _⟩))
    have hsu : s = Finset.univ := by
      rcases Finset.mem_insert.1 hs with rfl | hs
      · rfl
      · exact hex s hs
    have hm₂ : m₂ ∈ ({m₁} : Finset Math) := hse (hsu ▸ Finset.mem_univ m₂)
    exact hm (Finset.mem_singleton.1 hm₂).symm

end Exam

/-! ### Homogeneity parameters and *all* (§5.3) -/

/-- A homogeneity parameter: a candidate domain for every argument index and plurality
(§5.3.1). -/
abbrev HParam (Atom : Type*) := ℕ → Finset Atom → Finset (Finset Atom)

/-- A parameter is admissible when each of its values is a candidate for its plurality. -/
def HParam.Admissible (H : HParam Atom) : Prop := ∀ i x, H i x ∈ Cand x

/-- Two parameters agree except at the indices in `I`, the paper's (70). -/
def HParam.EquivExcept (I : Finset ℕ) (H H' : HParam Atom) : Prop :=
  ∀ k ∉ I, ∀ x, H k x = H' k x

omit [DecidableEq Atom] in
theorem HParam.EquivExcept.refl (I : Finset ℕ) (H : HParam Atom) : H.EquivExcept I H :=
  λ _ _ _ => rfl

omit [DecidableEq Atom] in
theorem HParam.EquivExcept.trans {I : Finset ℕ} {H H' H'' : HParam Atom}
    (h : H.EquivExcept I H') (h' : H'.EquivExcept I H'') : H.EquivExcept I H'' :=
  λ k hk x => (h k hk x).trans (h' k hk x)

/-- The parameter that reads index `i` universally and agrees with `H` elsewhere. -/
def HParam.univAt (H : HParam Atom) (i : ℕ) : HParam Atom :=
  λ k x => if k = i then {x} else H k x

theorem HParam.Admissible.univAt {H : HParam Atom} (hH : H.Admissible) (i : ℕ) :
    (H.univAt i).Admissible := by
  intro k x
  unfold HParam.univAt
  split_ifs
  · exact singleton_mem_Cand x
  · exact hH k x

omit [DecidableEq Atom] in
theorem HParam.equivExcept_univAt (H : HParam Atom) {I : Finset ℕ} {i : ℕ} (hi : i ∈ I) :
    H.EquivExcept I (H.univAt i) :=
  λ k hk x => by simp only [HParam.univAt, if_neg (λ h : k = i => hk (h ▸ hi))]

/-- A one-place predicate with argument index `i`, the paper's (53a). -/
def pred (H : HParam Atom) (i : ℕ) (P : Finset Atom → W → Prop) (x : Finset Atom) (w : W) :
    Prop :=
  reading (H i x) P w

/-- A two-place predicate with argument indices `i` and `j`, the paper's (53b). -/
def pred₂ (H : HParam Atom) (i j : ℕ) (R : Finset Atom → Finset Atom → W → Prop)
    (a b : Finset Atom) (w : W) : Prop :=
  ∃ z ∈ H i a, ∃ y ∈ H j b, R z y w

/-- The distributivity operator with argument index `i`, the paper's (63b). -/
def dist (H : HParam Atom) (i : ℕ) (Q : Atom → W → Prop) (x : Finset Atom) (w : W) : Prop :=
  pred H i (star Q) x w

/-- *all* with indices `I`, the paper's (71): true relative to every admissible parameter
that agrees with the current one outside `I`. -/
def all (I : Finset ℕ) (φ : HParam Atom → Finset Atom → W → Prop) (H : HParam Atom)
    (x : Finset Atom) (w : W) : Prop :=
  ∀ H' : HParam Atom, H'.Admissible → H.EquivExcept I H' → φ H' x w

/-- The candidate interpretations of a sentence: one proposition per admissible parameter. -/
def interpretations (φ : HParam Atom → W → Prop) : Set (W → Prop) :=
  {p | ∃ H : HParam Atom, H.Admissible ∧ p = φ H}

variable {H : HParam Atom} (hH : H.Admissible) {I : Finset ℕ} {i : ℕ} (hi : i ∈ I)
include hH hi

/-- *all* removes homogeneity and non-maximality on its argument: the sentence holds iff the
predicate holds of the whole plurality, whatever the parameter, the paper's (73)–(74). -/
theorem all_pred (P : Finset Atom → W → Prop) (x : Finset Atom) (w : W) :
    all I (λ H' => pred H' i P) H x w ↔ P x w := by
  constructor
  · intro h
    obtain ⟨z, hz, hP⟩ := h _ (hH.univAt i) (H.equivExcept_univAt hi)
    exact (Finset.mem_singleton.1 (by simpa [HParam.univAt] using hz)) ▸ hP
  · exact λ h H' hH' _ => ⟨x, self_mem_of_mem_Cand (hH' i x), h⟩

/-- *all* above negation, the paper's (78): *the girls all didn't dance* holds iff no part
of the girls danced. -/
theorem all_not_pred {x : Finset Atom} (hx : x.Nonempty) (P : Finset Atom → W → Prop) (w : W) :
    all I (λ H' x w => ¬ pred H' i P x w) H x w ↔ ∀ z ∈ parts x, ¬ P z w := by
  constructor
  · intro h z hz hP
    refine h (λ k y => if k = i ∧ y = x then parts x else H k y) ?_ ?_ ⟨z, ?_, hP⟩
    · intro k y
      dsimp only
      split_ifs with hky
      · rcases hky with ⟨rfl, rfl⟩
        exact parts_mem_Cand hx
      · exact hH k y
    · exact λ k hk y => (if_neg (λ h : k = i ∧ y = x => hk (h.1 ▸ hi)) :
        (if k = i ∧ y = x then parts x else H k y) = H k y).symm
    · simpa [pred] using hz
  · rintro h H' hH' _ ⟨z, hz, hP⟩
    exact h z (mem_parts_of_mem_Cand hx (hH' i x) hz) hP

/-- *all* is selective, the paper's (82): with *all* on the subject of a two-place predicate
the object still ranges over its candidate. -/
theorem all_pred₂ {j : ℕ} (hj : j ∉ I) (R : Finset Atom → Finset Atom → W → Prop)
    (a b : Finset Atom) (w : W) :
    all I (λ H' a w => pred₂ H' i j R a b w) H a w ↔ ∃ y ∈ H j b, R a y w := by
  constructor
  · intro h
    obtain ⟨z, hz, y, hy, hR⟩ := h _ (hH.univAt i) (H.equivExcept_univAt hi)
    have hz' : z = a := Finset.mem_singleton.1 (by simpa [HParam.univAt] using hz)
    have hji : j ≠ i := λ h => hj (h ▸ hi)
    have hy' : y ∈ H j b := by simpa [HParam.univAt, hji] using hy
    exact ⟨y, hy', hz' ▸ hR⟩
  · rintro ⟨y, hy, hR⟩ H' hH' hHH'
    exact ⟨a, self_mem_of_mem_Cand (hH' i a), y, (hHH' j hj b) ▸ hy, hR⟩

omit hi in
/-- *all* is idempotent, so floating *all* is vacuous under a quantifier that already
neutralizes the parameter, the paper's (92) and (97). -/
theorem all_all (φ : HParam Atom → Finset Atom → W → Prop) (x : Finset Atom) (w : W) :
    all I (λ H' => all I φ H') H x w ↔ all I φ H x w := by
  constructor
  · exact λ h => h H hH (HParam.EquivExcept.refl I H)
  · exact λ h H' _ hHH' H'' hH'' hH'H'' => h H'' hH'' (hHH'.trans hH'H'')

omit hH hi in
/-- *all* distributes over predicate coordination. -/
theorem all_and (φ ψ : HParam Atom → Finset Atom → W → Prop) (x : Finset Atom) (w : W) :
    all I (λ H' x w => φ H' x w ∧ ψ H' x w) H x w ↔ all I φ H x w ∧ all I ψ H x w := by
  simp only [all, forall_and]

/-- *all* over coordinated predicates, the paper's (104): *the professors all smiled and
left* holds iff both predicates hold of the whole plurality. -/
theorem all_pred_and {j : ℕ} (hj : j ∈ I) (P Q : Finset Atom → W → Prop) (x : Finset Atom)
    (w : W) :
    all I (λ H' x w => pred H' i P x w ∧ pred H' j Q x w) H x w ↔ P x w ∧ Q x w := by
  rw [all_and, all_pred hH hi, all_pred hH hj]

/-- *all* does not reach a pronoun bound by its associate, the paper's (108): *the chemists
all met a linguist they like* reads the subject universally while the pronoun keeps its
candidate. -/
theorem all_binding {k : ℕ} (hk : k ∉ I) (L : Finset Atom → W → Prop)
    (like met : Finset Atom → Finset Atom → W → Prop) (x : Finset Atom) (w : W) :
    all I (λ H' x w => ∃ y, L y w ∧ pred H' k (like y) x w ∧ pred H' i (met y) x w) H x w ↔
      ∃ y, L y w ∧ pred H k (like y) x w ∧ met y x w := by
  constructor
  · intro h
    obtain ⟨y, hL, hlike, z, hz, hmet⟩ := h _ (hH.univAt i) (H.equivExcept_univAt hi)
    have hz' : z = x := Finset.mem_singleton.1 (by simpa [HParam.univAt] using hz)
    have hki : k ≠ i := λ h => hk (h ▸ hi)
    refine ⟨y, hL, ?_, hz' ▸ hmet⟩
    simpa [pred, HParam.univAt, hki] using hlike
  · rintro ⟨y, hL, hlike, hmet⟩ H' hH' hHH'
    refine ⟨y, hL, ?_, x, self_mem_of_mem_Cand (hH' i x), hmet⟩
    simpa [pred, hHH' k hk x] using hlike

omit hH hi

/-- The negation of a distributive candidate is a distributive candidate for the negated
predicate: the domain generated by the transversals of the original parts, the paper's
footnote proof through disjunctive normal form. -/
theorem exists_cand_not_star {x : Finset Atom} (hx : x.Nonempty) {D : Finset (Finset Atom)}
    (hD : D ∈ Cand x) (Q : Atom → W → Prop) :
    ∃ D' ∈ Cand x, ∀ w, (¬ reading D (star Q) w ↔ reading D' (star λ a w => ¬ Q a w) w) := by
  classical
  obtain ⟨S, hS, rfl⟩ := mem_Cand.1 hD
  refine ⟨conv (insert x ((parts x).filter λ t => ∀ s ∈ insert x S, (t ∩ s).Nonempty)),
    mem_Cand.2 ⟨_, Finset.filter_subset _ _, rfl⟩, λ w => ?_⟩
  rw [reading_conv_insert x hS (λ _ _ h hz => star_antitone Q h hz),
    reading_conv_insert x (Finset.filter_subset _ _) (λ _ _ h hz => star_antitone _ h hz)]
  have hsub : ∀ s ∈ insert x S, s ⊆ x := λ s hs => by
    rcases Finset.mem_insert.1 hs with rfl | hs
    · exact Finset.Subset.refl _
    · exact (mem_parts.1 (hS hs)).2
  constructor
  · intro h
    unfold star at h
    push Not at h
    refine ⟨x.filter λ a => ¬ Q a w, Finset.mem_insert_of_mem ?_, λ a ha =>
      (Finset.mem_filter.1 ha).2⟩
    rw [Finset.mem_filter, mem_parts]
    obtain ⟨a, ha, hQ⟩ := h x (Finset.mem_insert_self _ _)
    refine ⟨⟨⟨a, Finset.mem_filter.2 ⟨ha, hQ⟩⟩, Finset.filter_subset _ _⟩, λ s hs => ?_⟩
    obtain ⟨b, hb, hQb⟩ := h s hs
    exact ⟨b, Finset.mem_inter.2 ⟨Finset.mem_filter.2 ⟨hsub s hs hb, hQb⟩, hb⟩⟩
  · rintro ⟨t, ht, hQt⟩ ⟨s, hs, hQs⟩
    rcases Finset.mem_insert.1 ht with rfl | ht
    · obtain ⟨a, ha⟩ : s.Nonempty := by
        rcases Finset.mem_insert.1 hs with rfl | hs
        · exact hx
        · exact (mem_parts.1 (hS hs)).1
      exact hQt a (hsub s hs ha) (hQs a ha)
    · obtain ⟨a, ha⟩ := (Finset.mem_filter.1 ht).2 s hs
      rw [Finset.mem_inter] at ha
      exact hQt a ha.1 (hQs a ha.2)

/-- Negation and distributivity commute in the set of candidate interpretations, the paper's
(69): scoping negation below or above `dist` yields the same propositions. -/
theorem interpretations_not_dist {x : Finset Atom} (hx : x.Nonempty) (i : ℕ)
    (Q : Atom → W → Prop) :
    interpretations (λ H w => ¬ dist H i Q x w) =
      interpretations (λ H w => dist H i (λ a w => ¬ Q a w) x w) := by
  have key : ∀ (Q : Atom → W → Prop) (H : HParam Atom), H.Admissible →
      ∃ H' : HParam Atom, H'.Admissible ∧
        ∀ w, (¬ dist H i Q x w ↔ dist H' i (λ a w => ¬ Q a w) x w) := by
    intro Q H hH
    obtain ⟨D', hD', h⟩ := exists_cand_not_star hx (hH i x) Q
    refine ⟨λ k y => if k = i ∧ y = x then D' else H k y, ?_, λ w => ?_⟩
    · intro k y
      dsimp only
      split_ifs with hky
      · rcases hky with ⟨rfl, rfl⟩
        exact hD'
      · exact hH k y
    · simpa [dist, pred] using h w
  ext p
  constructor
  · rintro ⟨H, hH, rfl⟩
    obtain ⟨H', hH', h⟩ := key Q H hH
    exact ⟨H', hH', funext λ w => propext (h w)⟩
  · rintro ⟨H, hH, rfl⟩
    obtain ⟨H', hH', h⟩ := key (λ a w => ¬ Q a w) H hH
    refine ⟨H', hH', funext λ w => propext ?_⟩
    have := h w
    simp only [dist, pred, star, reading, not_not] at this ⊢
    exact (not_iff_comm.1 this).symm

/-! ### Upward homogeneity (§3.3, Appendix)

The appendix's candidates (113) are generated by parts of `x` together with pluralities
containing `x`; the sentence is then false only when no plurality overlapping `x` satisfies
the predicate, which is [kriz-2016]'s generalised homogeneity. -/

section Upward

variable [Fintype Atom]

/-- The pluralities containing `x`. -/
abbrev sups (x : Finset Atom) : Finset (Finset Atom) := Finset.Icc x ⊤

/-- The candidate domains of the appendix, (113): convex closures of some parts of `x` and
some pluralities containing `x`, restricted to those containing `x` itself. -/
def CandUp (x : Finset Atom) : Finset (Finset (Finset Atom)) :=
  (((parts x).powerset ×ˢ (sups x).powerset).image λ p => conv (p.1 ∪ p.2)).filter (x ∈ ·)

theorem mem_CandUp {x : Finset Atom} {D : Finset (Finset Atom)} :
    D ∈ CandUp x ↔ (∃ A ⊆ parts x, ∃ B ⊆ sups x, conv (A ∪ B) = D) ∧ x ∈ D := by
  simp only [CandUp, Finset.mem_filter, Finset.mem_image, Finset.mem_product,
    Finset.mem_powerset, Prod.exists]
  exact and_congr_left' ⟨λ ⟨A, B, ⟨hA, hB⟩, h⟩ => ⟨A, hA, B, hB, h⟩,
    λ ⟨A, hA, B, hB, h⟩ => ⟨A, B, ⟨hA, hB⟩, h⟩⟩

/-- The paper's candidates are the appendix's with `x` as the only superplurality. -/
theorem Cand_subset_CandUp (x : Finset Atom) : Cand x ⊆ CandUp x := by
  intro D hD
  obtain ⟨S, hS, rfl⟩ := mem_Cand.1 hD
  refine mem_CandUp.2 ⟨⟨S, hS, {x}, ?_, ?_⟩, self_mem_of_mem_Cand hD⟩
  · exact Finset.singleton_subset_iff.2 (Finset.mem_Icc.2 ⟨le_rfl, le_top⟩)
  · rw [Finset.union_comm, ← Finset.insert_eq]

/-- Every member of an appendix candidate overlaps `x`. -/
theorem overlaps_of_mem_CandUp {x : Finset Atom} (hx : x.Nonempty) {D : Finset (Finset Atom)}
    (hD : D ∈ CandUp x) {z : Finset Atom} (hz : z ∈ D) : overlaps x z := by
  obtain ⟨⟨A, hA, B, hB, rfl⟩, -⟩ := mem_CandUp.1 hD
  obtain ⟨a, ha, -, -, haz, -⟩ := mem_conv.1 hz
  rw [overlaps, Finset.not_disjoint_iff]
  rcases Finset.mem_union.1 ha with ha | ha
  · obtain ⟨b, hb⟩ := (mem_parts.1 (hA ha)).1
    exact ⟨b, (mem_parts.1 (hA ha)).2 hb, haz hb⟩
  · obtain ⟨b, hb⟩ := hx
    exact ⟨b, hb, haz ((Finset.mem_Icc.1 (hB ha)).1 hb)⟩

/-- The weakest appendix candidate: every plurality overlapping `x`. -/
theorem filter_overlaps_mem_CandUp {x : Finset Atom} (hx : x.Nonempty) :
    Finset.univ.filter (overlaps x) ∈ CandUp x := by
  refine mem_CandUp.2 ⟨⟨parts x, Finset.Subset.refl _, sups x, Finset.Subset.refl _, ?_⟩, ?_⟩
  · ext z
    rw [mem_conv, Finset.mem_filter, overlaps, Finset.not_disjoint_iff]
    constructor
    · rintro ⟨a, ha, -, -, haz, -⟩
      refine ⟨Finset.mem_univ _, ?_⟩
      rcases Finset.mem_union.1 ha with ha | ha
      · obtain ⟨b, hb⟩ := (mem_parts.1 ha).1
        exact ⟨b, (mem_parts.1 ha).2 hb, haz hb⟩
      · obtain ⟨b, hb⟩ := hx
        exact ⟨b, hb, haz ((Finset.mem_Icc.1 ha).1 hb)⟩
    · rintro ⟨-, b, hbx, hbz⟩
      refine ⟨x ∩ z, Finset.mem_union_left _ (mem_parts.2 ⟨⟨b, Finset.mem_inter.2 ⟨hbx, hbz⟩⟩,
        Finset.inter_subset_left⟩), ⊤, Finset.mem_union_right _ (Finset.mem_Icc.2 ⟨le_top, le_rfl⟩),
        Finset.inter_subset_right, le_top⟩
  · exact Finset.mem_filter.2 ⟨Finset.mem_univ _, Finset.not_disjoint_iff.2
      (hx.imp λ a ha => ⟨ha, ha⟩)⟩

/-- Truth on all appendix readings is still truth of the whole plurality. -/
theorem trueOnAllUp_iff (x : Finset Atom) (P : Finset Atom → W → Prop) (w : W) :
    (∀ D ∈ CandUp x, reading D P w) ↔ P x w := by
  constructor
  · intro h
    obtain ⟨z, hz, hP⟩ := h {x} (Cand_subset_CandUp x (singleton_mem_Cand x))
    exact Finset.mem_singleton.1 hz ▸ hP
  · exact λ h D hD => ⟨x, (mem_CandUp.1 hD).2, h⟩

/-- Falsity on all appendix readings is the upward-homogeneity condition, the paper's
(114b): no plurality overlapping `x` satisfies the predicate. -/
theorem falseOnAllUp_iff {x : Finset Atom} (hx : x.Nonempty) (P : Finset Atom → W → Prop)
    (w : W) : (∀ D ∈ CandUp x, ¬ reading D P w) ↔ ∀ z, overlaps x z → ¬ P z w := by
  constructor
  · exact λ h z hz hP => h _ (filter_overlaps_mem_CandUp hx)
      ⟨z, Finset.mem_filter.2 ⟨Finset.mem_univ _, hz⟩, hP⟩
  · exact λ h D hD ⟨z, hz, hP⟩ => h z (overlaps_of_mem_CandUp hx hD hz) hP

/-- The trivalent value on the appendix's candidates. -/
def valueUp (x : Finset Atom) (P : Finset Atom → W → Prop) [∀ z w, Decidable (P z w)]
    (w : W) : Trivalent :=
  if ∀ D ∈ CandUp x, reading D P w then .true
  else if ∀ D ∈ CandUp x, ¬ reading D P w then .false else .indet

/-- The appendix's candidates give [kriz-2016]'s generalised homogeneity over all
pluralities. -/
theorem valueUp_eq_generalisedTruthValue {x : Finset Atom} (hx : x.Nonempty)
    (P : Finset Atom → W → Prop) [∀ z w, Decidable (P z w)] (w : W) :
    valueUp x P w = generalisedTruthValue (P · w) Finset.univ x := by
  unfold valueUp generalisedTruthValue
  by_cases hP : P x w
  · rw [if_pos ((trueOnAllUp_iff x P w).2 hP), if_pos hP]
  · rw [if_neg (λ h => hP ((trueOnAllUp_iff x P w).1 h)), if_neg hP]
    by_cases hn : ∀ z, overlaps x z → ¬ P z w
    · rw [if_pos ((falseOnAllUp_iff hx P w).2 hn), if_neg]
      rintro ⟨b, -, hb, hPb⟩
      exact hn b hb hPb
    · rw [if_neg (λ h => hn ((falseOnAllUp_iff hx P w).1 h)), if_pos]
      push Not at hn
      obtain ⟨b, hb, hPb⟩ := hn
      exact ⟨b, Finset.mem_univ _, hb, hPb⟩

end Upward

end KrizSpector2021
