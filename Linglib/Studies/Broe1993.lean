import Mathlib.Data.Finset.Basic
import Mathlib.Tactic.FinCases

/-!
# Broe 1993: structured specification

This file formalizes the treatment of redundancy in [broe-1993]. Underspecified matrices and
redundancy rules are replaced by a lattice: the descriptions a feature set supports, ordered by
inclusion of their denotations, and redundancy read off its dominance relation. `naturalClasses`
computes that lattice's extents from an inventory and the extents of its feature values, and is
shown to be the closure system they generate — the construction Broe takes from formal concept
analysis. The Quileute vowel system and its gapped variant are the worked examples of §5.2.2.

## Main definitions

* `naturalClasses` — the extents generated by an inventory and its attribute extents

## Main results

* `mem_naturalClasses` — a class is an intersection of the inventory with attribute extents
* `naturalClasses_inter_mem`, `naturalClasses_minimal` — the classes are the closure system those
  extents generate
* `quileute_classes`, `quileutePrime_classes` — the two worked lattices
* `quileute_no_redundancy`, `quileutePrime_redundancy` — a gapless system has no dominance among
  its attribute extents; the gapped one has Broe's two redundancies

## References

* [broe-1993]
-/

namespace Broe1993

variable {α : Type*} [DecidableEq α]

/-- The extents of the lattice of representations (§5.2.2): every intersection of the inventory
`base` with attribute extents drawn from `attrs`, deduplicated. Descriptions with the same
denotation collapse to one class, and an unsatisfiable description to the empty class. -/
def naturalClasses (base : Finset α) (attrs : List (Finset α)) : List (Finset α) :=
  attrs.foldr (λ a acc => (acc ++ acc.map (a ∩ ·)).dedup) [base]

/-- Unfolding one attribute extent: the classes of `a :: attrs` are those of `attrs` together with
their meets with `a`. -/
theorem naturalClasses_cons (base a : Finset α) (attrs : List (Finset α)) :
    naturalClasses base (a :: attrs)
      = (naturalClasses base attrs ++ (naturalClasses base attrs).map (a ∩ ·)).dedup := rfl

/-- The inventory itself is a natural class — the lattice's top. -/
theorem base_mem_naturalClasses (base : Finset α) (attrs : List (Finset α)) :
    base ∈ naturalClasses base attrs := by
  induction attrs with
  | nil => simp [naturalClasses]
  | cons a rest ih => simp [naturalClasses_cons, ih]

/-- Meeting a natural class with an attribute extent gives a natural class: the classes are closed
under the meets that generate them. -/
theorem naturalClasses_inter_mem {base : Finset α} {attrs : List (Finset α)} {a s : Finset α}
    (ha : a ∈ attrs) (hs : s ∈ naturalClasses base attrs) :
    a ∩ s ∈ naturalClasses base attrs := by
  induction attrs generalizing s with
  | nil => simp at ha
  | cons b rest ih =>
    rw [naturalClasses_cons] at hs ⊢
    simp only [List.mem_dedup, List.mem_append, List.mem_map] at hs ⊢
    rcases List.mem_cons.mp ha with rfl | ha'
    · rcases hs with hs | ⟨t, ht, rfl⟩
      · exact .inr ⟨s, hs, rfl⟩
      · exact .inr ⟨t, ht, by rw [← Finset.inter_assoc, Finset.inter_self]⟩
    · rcases hs with hs | ⟨t, ht, rfl⟩
      · exact .inl (ih ha' hs)
      · refine .inr ⟨a ∩ t, ih ha' ht, ?_⟩
        rw [← Finset.inter_assoc, ← Finset.inter_assoc, Finset.inter_comm a b]

/-- A natural class is the inventory met with attribute extents, and every such meet is a natural
class. -/
theorem mem_naturalClasses {base : Finset α} {attrs : List (Finset α)} {s : Finset α} :
    s ∈ naturalClasses base attrs ↔
      ∃ sub : List (Finset α), (∀ a ∈ sub, a ∈ attrs) ∧ s = sub.foldr (· ∩ ·) base := by
  constructor
  · induction attrs generalizing s with
    | nil => intro hs; exact ⟨[], by simp, by simpa [naturalClasses] using hs⟩
    | cons a rest ih =>
      rw [naturalClasses_cons]
      simp only [List.mem_dedup, List.mem_append, List.mem_map]
      rintro (hs | ⟨t, ht, rfl⟩)
      · obtain ⟨sub, hmem, rfl⟩ := ih hs
        exact ⟨sub, fun c hc => List.mem_cons_of_mem _ (hmem c hc), rfl⟩
      · obtain ⟨sub, hmem, rfl⟩ := ih ht
        exact ⟨a :: sub, by
          simpa using fun c hc => List.mem_cons_of_mem _ (hmem c hc), rfl⟩
  · rintro ⟨sub, hmem, rfl⟩
    induction sub with
    | nil => exact base_mem_naturalClasses base attrs
    | cons a rest ih =>
      exact naturalClasses_inter_mem (hmem a List.mem_cons_self)
        (ih fun c hc => hmem c (List.mem_cons_of_mem _ hc))

/-- Every collection that contains the inventory and is closed under meeting with the attribute
extents contains all the natural classes: the construction is the closure system the attribute
extents generate, not a larger collection. -/
theorem naturalClasses_minimal {base : Finset α} {attrs : List (Finset α)} {C : Set (Finset α)}
    (hbase : base ∈ C) (hclosed : ∀ a ∈ attrs, ∀ s ∈ C, a ∩ s ∈ C) :
    ∀ s ∈ naturalClasses base attrs, s ∈ C := by
  intro s hs
  obtain ⟨sub, hmem, rfl⟩ := mem_naturalClasses.mp hs
  clear hs
  induction sub with
  | nil => exact hbase
  | cons a rest ih =>
    exact hclosed a (hmem a List.mem_cons_self) _
      (ih fun c hc => hmem c (List.mem_cons_of_mem _ hc))

/-! ### Quileute -/

/-- The four-vowel system of §5.2.2: /i a ɑ u/, exhaustively classified by [high] and [back]. -/
inductive Quileute where
  /-- /i/ — [+high, −back]. -/
  | i
  /-- /a/ — [−high, −back]. -/
  | a
  /-- /ɑ/ — [−high, +back]. -/
  | aBack
  /-- /u/ — [+high, +back]. -/
  | u
  deriving DecidableEq

/-- The Quileute attribute extents: [+hi], [−hi], [+ba], [−ba]. -/
def quileuteContext : List (Finset Quileute) :=
  [{.i, .u}, {.a, .aBack}, {.u, .aBack}, {.i, .a}]

/-- Every feature combination is attested and every description informative: the lattice of
diagram (6) — all four two-vowel classes, all four singletons, top, and bottom. -/
theorem quileute_classes :
    (naturalClasses {.i, .a, .aBack, .u} quileuteContext).toFinset =
      {{.i, .a, .aBack, .u}, {.i, .u}, {.a, .aBack}, {.u, .aBack}, {.i, .a},
       {.i}, {.a}, {.aBack}, {.u}, ∅} := by decide

/-- No feature value can be predicted from another: no attribute extent dominates another, so the
gapless system carries no redundancy. -/
theorem quileute_no_redundancy (a b : Finset Quileute) (ha : a ∈ quileuteContext)
    (hb : b ∈ quileuteContext) (hab : a ⊆ b) : a = b := by
  fin_cases ha <;> fin_cases hb <;> revert hab <;> decide

/-- The reduced system without /a/ (Quileuteʹ): the same four descriptions, with /a/ removed from
the extents. -/
def quileutePrimeContext : List (Finset Quileute) :=
  [{.i, .u}, {.aBack}, {.u, .aBack}, {.i}]

/-- With the [−hi, −ba] gap, the lattice collapses to diagram (9): [−hi] and [−hi, +ba] become
synonymous — one class `{ɑ}` — and the incompatible description [−hi, −ba] falls to bottom. -/
theorem quileutePrime_classes :
    (naturalClasses {.i, .aBack, .u} quileutePrimeContext).toFinset =
      {{.i, .aBack, .u}, {.i, .u}, {.u, .aBack}, {.i}, {.aBack}, {.u}, ∅} := by
  decide

/-- The redundancy rules Broe reads off the collapsed lattice's dominance relation (p. 104),
[−back] → [+high] and [−high] → [+back], as the extent inclusions the gapless system lacked. -/
theorem quileutePrime_redundancy :
    ({.i} : Finset Quileute) ⊆ {.i, .u} ∧ ({.aBack} : Finset Quileute) ⊆ {.u, .aBack} := by
  decide

end Broe1993
