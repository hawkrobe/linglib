module

public import Mathlib.Data.Finset.Card
public import Linglib.Syntax.Minimalist.Defs
public import Linglib.Syntax.Tree.Command
public import Linglib.Syntax.Binding.Basic
public import Linglib.Syntax.Case.Dependent

/-!
# Newman (2024): *When Arguments Merge*

This file formalizes Newman's theory of feature-driven Merge and its consequences for the verb
phrase. A head bears Merge features, and an element merging with it checks every unchecked feature
it can. Features may go unchecked, and they belong to categories rather than to lexical items: V
bears `[·D·]`, checked by a DP, and `[·X·]`, checked by anything, and v in addition `[·V·]` and
`[·wh·]`. Since a DP checks everything a non-DP checks and a wh-DP everything a DP checks, a phrase
checking a subset of another's features must merge first. Newman derives from this where
arguments go in the verb phrase, the binding pattern of the dative alternation, agent focus in
Mayan subject questions, and the double object movement asymmetry of passives.

## Main definitions

* `Licensed`: a sequence of merges with one head, each checking a feature still unchecked.
* `WeakEconomy`: the economy condition on the choice among possible operations.
* `Phrase.checks`, `bundleV`, `bundlev`: the features a phrase checks and those V and v bear.
* `configuration`: the binding theory, m-command without reverse c-command.
* `AgentFocus`: Voice and T cross-reference one argument, so Voice is spelled out as agent focus.
* `Economical`: a passive derivation at v in which every step respects Weak Economy.

## Main results

* `Licensed.not_sublist`: an element checking only features another checks cannot follow it.
* `nonDP_first`, `not_dp_after_dp`: non-DP arguments are complements, one DP per head.
* `wordOrder_binding`: the direct object can bind the indirect object only when it precedes it.
* `transitive_derivations`, `agentFocus_iff`: a subject question has two derivations, an object
  question one, and agent focus arises exactly when the object checks `[·D·]` first.
* `doma`, `symmetric_passive`, `iobj_kp_not_subject`: a wh indirect object must be the passive
  subject, plain objects either one, an inherent-case indirect object never.

## Implementation notes

A phrase's checkable features are read off its category and `[wh]`. By Generalized Tucking In,
Paillé's extension of Richards's tucking in, the first specifier merged is outermost. M-command is
Barker and Pullum's command relation generated by the maximal projections, and case is Marantz's
dependent case. As in Newman's chapter 3, VP is v's complement in the subject-question derivations.
A passive derivation ends only when nothing available can check a feature, as Preminger's
obligatory operations require.

## TODO

Chapter 5's object marking and Greek clitic doubling need a φ-probe and `[·Dweak·]` on v, and the
bleeding of clitic doubling by wh-movement is structural rather than featural. Chapters 6 and 7
are not formalized.

## References

* [newman-2024]
* [preminger-2014]
* [richards-1997]
* [paille-2020]
* [marantz-1991]
* [barker-pullum-1990]
-/

@[expose] public section

namespace Newman2024

open scoped List
open Minimalist (Cat)
open Core.Order (TreePath)

/-! ### Feature-driven Merge -/

section Merge

variable {F α : Type*} [DecidableEq F] (κ : α → Finset F)

/-- `Licensed κ s es` holds when the elements `es` can merge in order with a head whose unchecked
Merge features are `s`, where `κ e` is the set of features `e` can check. Each element checks every
unchecked feature it can, and at least one; features left over at the end are allowed. -/
def Licensed : Finset F → List α → Prop
  | _, [] => True
  | s, e :: es => (s ∩ κ e).Nonempty ∧ Licensed (s \ κ e) es

instance decLicensed : (s : Finset F) → (es : List α) → Decidable (Licensed κ s es)
  | _, [] => isTrue trivial
  | s, e :: es =>
    haveI := decLicensed (s \ κ e) es
    inferInstanceAs (Decidable (_ ∧ _))

/-- Merging `a` bleeds merging `b`, at a head with unchecked features `s`, when after `a` has
merged `b` can check nothing. -/
def Bleeds (s : Finset F) (a b : α) : Prop := (s \ κ a) ∩ κ b = ∅

instance (s : Finset F) (a b : α) : Decidable (Bleeds κ s a b) :=
  inferInstanceAs (Decidable (_ = _))

/-- **Weak Economy** permits merging `a` among the operations `ops` when every operation checking
more features than `a` would bleed it. -/
def WeakEconomy (s : Finset F) (ops : List α) (a : α) : Prop :=
  ∀ b ∈ ops, (s ∩ κ a).card < (s ∩ κ b).card → Bleeds κ s b a

instance (s : Finset F) (ops : List α) (a : α) : Decidable (WeakEconomy κ s ops a) :=
  inferInstanceAs (Decidable (∀ b ∈ ops, _))

variable {κ} {s : Finset F} {es : List α}

@[simp] theorem licensed_nil : Licensed κ s [] := trivial

@[simp] theorem licensed_cons {e : α} :
    Licensed κ s (e :: es) ↔ (s ∩ κ e).Nonempty ∧ Licensed κ (s \ κ e) es := Iff.rfl

/-- Every element of a licensed sequence can check one of the head's features. -/
theorem Licensed.nonempty_of_mem (h : Licensed κ s es) {b : α} (hb : b ∈ es) :
    (s ∩ κ b).Nonempty := by
  induction es generalizing s with
  | nil => simp at hb
  | cons e es ih =>
    obtain ⟨h₁, h₂⟩ := licensed_cons.1 h
    rcases List.mem_cons.1 hb with rfl | hb
    · exact h₁
    · exact (ih h₂ hb).mono (Finset.inter_subset_inter Finset.sdiff_subset subset_rfl)

/-- If `b` can check only features of the head that `a` also checks, `b` cannot merge after `a`,
which has already checked them. -/
theorem Licensed.not_sublist (h : Licensed κ s es) {a b : α} (hab : s ∩ κ b ⊆ κ a) :
    ¬ [a, b] <+ es := by
  induction es generalizing s with
  | nil => simp
  | cons e es ih =>
    obtain ⟨_, h₂⟩ := licensed_cons.1 h
    intro hs
    rcases List.sublist_cons_iff.1 hs with hs | ⟨r, hr, hs⟩
    · exact ih h₂ ((Finset.inter_subset_inter Finset.sdiff_subset subset_rfl).trans hab) hs
    · obtain ⟨rfl, rfl⟩ := List.cons_eq_cons.1 hr
      obtain ⟨x, hx⟩ := h₂.nonempty_of_mem (List.singleton_sublist.1 hs)
      rw [Finset.mem_inter, Finset.mem_sdiff] at hx
      exact hx.1.2 (hab (Finset.mem_inter.2 ⟨hx.1.1, hx.2⟩))

/-- If every element can check whatever `b` can check among the head's features, `b` merges
first. -/
theorem Licensed.head?_eq (h : Licensed κ s es) {b : α} (hb : b ∈ es)
    (hsub : ∀ a ∈ es, s ∩ κ b ⊆ κ a) : es.head? = some b := by
  cases es with
  | nil => simp at hb
  | cons e es =>
    rcases List.mem_cons.1 hb with rfl | hb
    · rfl
    · exact absurd (List.cons_sublist_cons.2 (List.singleton_sublist.2 hb))
        (h.not_sublist (hsub e List.mem_cons_self))

/-- A head licenses at most as many merges as it has Merge features. -/
theorem Licensed.length_le (h : Licensed κ s es) : es.length ≤ s.card := by
  induction es generalizing s with
  | nil => simp
  | cons e es ih =>
    obtain ⟨h₁, h₂⟩ := licensed_cons.1 h
    have := Finset.card_sdiff_add_card_inter s (κ e)
    have := h₁.card_pos
    have := ih h₂
    simp only [List.length_cons]
    omega

/-- An operation never bleeds one checking more features, so Weak Economy's optionality can only
come from the operation checking more. -/
theorem Bleeds.card_le {a b : α} (h : Bleeds κ s a b) : (s ∩ κ b).card ≤ (s ∩ κ a).card := by
  refine Finset.card_le_card fun x hx ↦ ?_
  rw [Finset.mem_inter] at hx ⊢
  by_contra hxa
  have : x ∈ (s \ κ a) ∩ κ b := by simp_all
  rw [Bleeds] at h
  simp [h] at this

end Merge

/-- If no two elements satisfying `p` occur in order in `l`, at most one does. -/
private theorem length_filter_le_one {α : Type*} {l : List α} {p : α → Bool}
    (h : ∀ a b, p a → p b → ¬ [a, b] <+ l) : (l.filter p).length ≤ 1 := by
  match hl : l.filter p with
  | [] | [_] => simp
  | a :: b :: t =>
    have hs : [a, b] <+ l := (List.cons_sublist_cons.2 (List.cons_sublist_cons.2
      (List.nil_sublist t))).trans (hl ▸ List.filter_sublist)
    have ha : a ∈ l.filter p := by simp [hl]
    have hb : b ∈ l.filter p := by simp [hl]
    exact absurd hs (h a b (List.mem_filter.1 ha).2 (List.mem_filter.1 hb).2)

/-- `lists l n` collects the lists of length at most `n` over `l`. -/
private def lists {α : Type*} (l : List α) : ℕ → List (List α)
  | 0 => [[]]
  | n + 1 => [] :: l.flatMap fun a ↦ (lists l n).map (a :: ·)

private theorem mem_lists {α : Type*} {l : List α} (hl : ∀ x, x ∈ l) :
    ∀ {n : ℕ} {es : List α}, es.length ≤ n → es ∈ lists l n
  | 0, [], _ => List.mem_singleton_self _
  | n + 1, [], _ => List.mem_cons_self
  | n + 1, a :: es, h => List.mem_cons_of_mem _ <| List.mem_flatMap.2
      ⟨a, hl a, List.mem_map.2 ⟨es, mem_lists hl (by simpa using h), rfl⟩⟩

/-! ### The Categorial Merge Hypothesis -/

/-- The Merge features that introduce and move arguments are `[·D·]`, checked by a DP, the
category-unspecified `[·X·]`, checked by anything, `[·V·]`, checked by a VP, and `[·wh·]`, checked
by a wh-phrase. -/
inductive Feature where
  | D
  | X
  | V
  | wh
  deriving DecidableEq, Repr

/-- A phrase, as Merge features see it, is its category and whether it bears `[wh]`. -/
structure Phrase where
  cat : Cat
  wh : Bool := false
  deriving DecidableEq, Repr

namespace Phrase

/-- A phrase checks `[·X·]`, and `[·D·]`, `[·V·]` or `[·wh·]` when it is a DP, a VP or a
wh-phrase. -/
def checks (p : Phrase) : Finset Feature :=
  {.X} ∪ (if p.cat = .D then {.D} else ∅) ∪ (if p.cat = .V then {.V} else ∅) ∪
    (if p.wh then {.wh} else ∅)

@[simp] theorem mem_checks {p : Phrase} {f : Feature} :
    f ∈ p.checks ↔ f = .X ∨ f = .D ∧ p.cat = .D ∨ f = .V ∧ p.cat = .V ∨ f = .wh ∧ p.wh := by
  unfold checks
  split_ifs <;> simp_all

/-- A phrase that is neither a DP, a VP nor a wh-phrase checks only `[·X·]`. -/
theorem checks_eq_X {p : Phrase} (hD : p.cat ≠ .D) (hV : p.cat ≠ .V) (hwh : p.wh = false) :
    p.checks = {.X} := by
  ext f; cases f <;> simp [hD, hV, hwh]

/-- A wh-DP checks everything a DP checks. -/
theorem checks_dp_subset_whDP : (⟨.D, false⟩ : Phrase).checks ⊆ (⟨.D, true⟩ : Phrase).checks := by
  intro f; cases f <;> simp

/-- A DP checks everything a phrase that is neither a VP nor a wh-phrase checks. -/
theorem checks_subset_dp {p : Phrase} (hV : p.cat ≠ .V) (hwh : p.wh = false) :
    p.checks ⊆ (⟨.D, false⟩ : Phrase).checks := by
  intro f; cases f <;> simp_all

end Phrase

/-- V bears `[·D·]` and `[·X·]`, whatever the verb. -/
def bundleV : Finset Feature := {.D, .X}

/-- v bears V's features, `[·V·]` for merging VP, and `[·wh·]` for successive-cyclic movement. -/
def bundlev : Finset Feature := {.D, .X, .V, .wh}

/-! ### The distribution of DPs and non-DPs -/

section Distribution

variable {α : Type*} {f : α → Phrase} {s : Finset Feature} {es : List α}

/-- **The non-DP first theorem.** A phrase that checks nothing but `[·X·]` merges first with any
head it merges with, so it is that head's complement. -/
theorem nonDP_first (h : Licensed (Phrase.checks ∘ f) s es) {b : α} (hb : b ∈ es)
    (hD : (f b).cat ≠ .D) (hV : (f b).cat ≠ .V) (hwh : (f b).wh = false) : es.head? = some b :=
  h.head?_eq hb fun a _ ↦ Finset.inter_subset_right.trans <| by
    simp [Function.comp_apply, Phrase.checks_eq_X hD hV hwh]

/-- A non-DP argument of v makes VP a specifier rather than v's complement. -/
theorem vp_specifier (h : Licensed (Phrase.checks ∘ f) bundlev es) {b vp : α} (hb : b ∈ es)
    (hD : (f b).cat ≠ .D) (hV : (f b).cat ≠ .V) (hwh : (f b).wh = false) (hne : vp ≠ b) :
    es.head? ≠ some vp := by
  rw [nonDP_first h hb hD hV hwh]
  simpa using hne.symm

/-- **One DP per head.** A DP without a further feature cannot merge after another DP. -/
theorem not_dp_after_dp (h : Licensed (Phrase.checks ∘ f) s es) {a b : α} (ha : (f a).cat = .D)
    (hb : (f b).cat = .D) (hwh : (f b).wh = false) : ¬ [a, b] <+ es :=
  h.not_sublist <| Finset.inter_subset_right.trans fun x ↦ by
    cases x <;> simp_all [Function.comp_apply]

/-- A head introduces at most one DP without `[wh]`. -/
theorem length_filter_dp_le_one (h : Licensed (Phrase.checks ∘ f) s es) :
    (es.filter fun a ↦ (f a).cat = .D ∧ (f a).wh = false).length ≤ 1 :=
  length_filter_le_one fun _ _ ha hb ↦ by
    simp only [decide_eq_true_eq] at ha hb
    exact not_dp_after_dp h ha.1 hb.1 hb.2

/-- A head introduces at most one argument that is neither a DP, a VP nor a wh-phrase. -/
theorem length_filter_nonDP_le_one (h : Licensed (Phrase.checks ∘ f) s es) :
    (es.filter fun a ↦ (f a).cat ≠ .D ∧ (f a).cat ≠ .V ∧ (f a).wh = false).length ≤ 1 :=
  length_filter_le_one fun a _ _ hb ↦ by
    simp only [decide_eq_true_eq] at hb
    exact h.not_sublist <| Finset.inter_subset_right.trans <| by
      simp [Function.comp_apply, Phrase.checks_eq_X hb.1 hb.2.1 hb.2.2]

/-- V takes a non-DP complement and then a DP, but not a DP and then a non-DP. -/
example : Licensed Phrase.checks bundleV [⟨.P, false⟩, ⟨.D, false⟩] ∧
    ¬ Licensed Phrase.checks bundleV [⟨.D, false⟩, ⟨.P, false⟩] := by decide

/-- *Bet* uses every argument feature. V takes the clause and then the wager, and v takes the
applied dative, then VP as a specifier, then the bettor. -/
example : Licensed Phrase.checks bundleV [⟨.C, false⟩, ⟨.D, false⟩] ∧
    Licensed Phrase.checks bundlev [⟨.Appl, false⟩, ⟨.V, false⟩, ⟨.D, false⟩] := by decide

end Distribution

/-! ### The dative alternation -/

/-- A node of a tree is a head, an intermediate projection, or a maximal projection. -/
inductive Level where
  | head
  | bar
  | max
  deriving DecidableEq, Repr

/-- A leaf of a ditransitive vP is the external argument, v, V, the direct object, or the phrase
containing the indirect object. -/
inductive Leaf where
  | subj
  | v
  | V
  | dobj
  | iobj
  deriving DecidableEq, Repr

/-- An `XTree` is a tree whose nodes carry a category and a projection level. -/
abbrev XTree := Syntax.Tree (Cat × Level) Leaf

/-- A tree counts for Merge features as a phrase of its root's category. -/
def XTree.checks (t : XTree) : Finset Feature := Phrase.checks ⟨t.cat.1, false⟩

/-- `bar c h comp specs` is the stack of intermediate projections of the phrase headed by `h`,
with complement `comp` and specifiers `specs`. -/
def bar (c : Cat) (h comp : XTree) : List XTree → XTree
  | [] => .node (c, .bar) [h, comp]
  | s :: ss => .node (c, .bar) [s, bar c h comp ss]

/-- `project c h es` is the phrase the head `h` of category `c` projects when `es` merge with it.
The first is the complement, and each later one tucks in below the specifiers already merged, so
the first specifier is outermost. -/
def project (c : Cat) (h : XTree) : List XTree → XTree
  | [] => .node (c, .max) [h]
  | [comp] => .node (c, .max) [h, comp]
  | comp :: s :: ss => .node (c, .max) [s, bar c h comp ss]

/-- `subjP` is the external argument, a DP. -/
def subjP : XTree := .terminal (.D, .max) .subj

/-- `dobjP` is the direct object, a DP. -/
def dobjP : XTree := .terminal (.D, .max) .dobj

/-- `iobjP` is the phrase containing the indirect object, a PP or an applicative phrase. -/
def iobjP : XTree := .terminal (.P, .max) .iobj

/-- `vHead` is the head v. -/
def vHead : XTree := .terminal (.v, .head) .v

/-- `VHead` is the head V. -/
def VHead : XTree := .terminal (.V, .head) .V

/-- `lowXP` is the ditransitive with the indirect object in V's complement. -/
def lowXP : XTree := project .v vHead [project .V VHead [iobjP, dobjP], subjP]

/-- `highXP` is the ditransitive with the indirect object in v's complement and VP a specifier
linearized on the left. -/
def highXP : XTree := project .v vHead [iobjP, subjP, project .V VHead [dobjP]]

/-- `highXPRight` is `highXP` with the VP specifier linearized on the right. -/
def highXPRight : XTree :=
  .node (.v, .max) [subjP, .node (.v, .bar) [.node (.v, .bar) [vHead, iobjP],
    project .V VHead [dobjP]]]

/-- `ditransitives` lists the three ditransitive vPs. -/
def ditransitives : List XTree := [lowXP, highXP, highXPRight]

/-- Both structures come from licensed derivations, and VP cannot be v's complement when the
phrase containing the indirect object merges with v. -/
theorem ditransitives_licensed :
    Licensed XTree.checks bundleV [iobjP, dobjP] ∧
      Licensed XTree.checks bundlev [project .V VHead [iobjP, dobjP], subjP] ∧
      Licensed XTree.checks bundleV [dobjP] ∧
      Licensed XTree.checks bundlev [iobjP, subjP, project .V VHead [dobjP]] ∧
      ¬ Licensed XTree.checks bundlev [project .V VHead [dobjP], iobjP, subjP] := by
  decide

/-- In the binding configuration of a tree, `a` commands `b` when every maximal projection
properly dominating `a` dominates `b` and `b` does not c-command `a`. Binding is not restricted to
a domain. -/
def configuration (t : XTree) : Binding.Configuration TreePath where
  commands a b := (a, b) ∈ Syntax.Tree.maxCommand t {n | n.2 = .max} ∧
    ¬ Syntax.Tree.CCommands t b a
  domain _ := Set.univ

instance (t : XTree) : DecidableRel (configuration t).commands := fun a b ↦
  inferInstanceAs (Decidable ((a, b) ∈ Syntax.Tree.maxCommand t _ ∧ _))

/-- `leafPaths t` pairs each leaf of `t` with its position. -/
def leafPaths (t : XTree) : List (Leaf × TreePath) :=
  t.fold (fun _ w ↦ [(w, ⊥)])
    (fun _ bs ↦ bs.zipIdx.flatMap fun (ps, i) ↦ ps.map fun (w, p) ↦ (w, ⟨i :: p.toList⟩))
    (fun _ _ ↦ []) (fun _ _ ps ↦ ps.map fun (w, p) ↦ (w, ⟨0 :: p.toList⟩))

/-- The leaf `x` can bind the leaf `y` in `t`. -/
def CanBind (t : XTree) (x y : Leaf) : Prop :=
  ∃ a ∈ (leafPaths t).lookup x, ∃ b ∈ (leafPaths t).lookup y, (configuration t).commands a b

instance (t : XTree) (x y : Leaf) : Decidable (CanBind t x y) :=
  inferInstanceAs (Decidable (∃ a ∈ _, _))

/-- The leaf `x` precedes the leaf `y` in `t`. -/
def Precedes (t : XTree) (x y : Leaf) : Prop := t.yield.idxOf x < t.yield.idxOf y

instance (t : XTree) (x y : Leaf) : Decidable (Precedes t x y) :=
  inferInstanceAs (Decidable (_ < _))

/-- With the indirect object in V's complement, the direct object binds it and not conversely;
with it in v's complement, the converse holds, however VP is linearized. -/
theorem canBind_dobj_iobj :
    CanBind lowXP .dobj .iobj ∧ ¬ CanBind lowXP .iobj .dobj ∧
      ∀ t ∈ [highXP, highXPRight], CanBind t .iobj .dobj ∧ ¬ CanBind t .dobj .iobj := by
  decide

/-- With the indirect object in v's complement neither object c-commands the other. -/
theorem highXP_not_cCommands :
    ∃ a ∈ (leafPaths highXP).lookup .dobj, ∃ b ∈ (leafPaths highXP).lookup .iobj,
      ¬ Syntax.Tree.CCommands highXP a b ∧ ¬ Syntax.Tree.CCommands highXP b a := by
  decide

/-- **Word order and binding.** When the indirect object precedes the direct object, the direct
object cannot bind it; when it follows, either can bind the other. -/
theorem wordOrder_binding :
    (∀ t ∈ ditransitives, Precedes t .iobj .dobj → ¬ CanBind t .dobj .iobj) ∧
      (∃ t ∈ ditransitives, Precedes t .dobj .iobj ∧ CanBind t .dobj .iobj) ∧
      (∃ t ∈ ditransitives, Precedes t .dobj .iobj ∧ CanBind t .iobj .dobj) := by
  decide

/-! ### Subject questions and agent focus -/

/-- The phrases merging with v in a transitive clause are VP, the internal argument moving out
of it, and the external argument. -/
inductive Transitive where
  | vp
  | obj
  | subj
  deriving DecidableEq, Repr

/-- `Transitive.phrase w a` is the phrase `a` is when `w` is the wh-phrase. -/
def Transitive.phrase (w : Option Transitive) : Transitive → Phrase
  | .vp => ⟨.V, false⟩
  | a => ⟨.D, decide (w = some a)⟩

/-- `TransitiveDerivation w es` says that VP merges with v as its complement and then the
specifiers `es` merge, with `w` the wh-phrase. -/
abbrev TransitiveDerivation (w : Option Transitive) (es : List Transitive) : Prop :=
  Licensed (Phrase.checks ∘ Transitive.phrase w) bundlev (.vp :: es)

private theorem length_le_of_transitive {w : Option Transitive} {es : List Transitive}
    (h : TransitiveDerivation w es) : es.length ≤ 3 := by
  have := h.length_le
  simp only [List.length_cons] at this
  have : bundlev.card = 4 := by decide
  omega

/-- **Subject and object questions.** With an external argument and the wh-phrase passing
through the edge of vP, a subject question has two derivations, the subject checking `[·D·]` and
`[·wh·]` at once or the object checking `[·D·]` first; an object question has one, the subject
merging before the wh-object. -/
theorem transitive_derivations {es : List Transitive} :
    (TransitiveDerivation (some .subj) es ∧ .subj ∈ es ↔ es = [.subj] ∨ es = [.obj, .subj]) ∧
      (TransitiveDerivation (some .obj) es ∧ .subj ∈ es ∧ .obj ∈ es ↔ es = [.subj, .obj]) := by
  have hl : ∀ x, x ∈ [Transitive.vp, .obj, .subj] := by intro x; cases x <;> simp
  refine ⟨⟨fun ⟨h, hs⟩ ↦ ?_, by rintro (rfl | rfl) <;> decide⟩,
    ⟨fun ⟨h, hs, ho⟩ ↦ ?_, by rintro rfl; decide⟩⟩
  · exact (by decide : ∀ es ∈ lists [Transitive.vp, .obj, .subj] 3,
      TransitiveDerivation (some .subj) es → .subj ∈ es → es = [.subj] ∨ es = [.obj, .subj])
      es (mem_lists hl (length_le_of_transitive h)) h hs
  · exact (by decide : ∀ es ∈ lists [Transitive.vp, .obj, .subj] 3,
      TransitiveDerivation (some .obj) es → .subj ∈ es → .obj ∈ es → es = [.subj, .obj])
      es (mem_lists hl (length_le_of_transitive h)) h hs ho

/-- `heightOrder es` lists the arguments from the highest down once the specifiers `es` have
merged, the specifiers first with the first merged outermost, then the object in situ unless it
has moved. -/
def heightOrder (es : List Transitive) : List Transitive :=
  es.filter (· ≠ .vp) ++ if .obj ∈ es then [] else [.obj]

/-- When the first specifier merges, the dependent rules of an ergative grammar assign case to
the arguments then in vP, highest first and without the moved object's lower copy. A specifier
merged later is unmarked. -/
def caseOf (es : List Transitive) (a : Transitive) : Option Case :=
  let r := Case.Rules.ofAlignment .ergative
  let dom := match es with
    | s :: _ => if s = .obj then [Transitive.obj] else [s, .obj]
    | [] => [.obj]
  match ((r.unmarkedPass (fun _ ↦ true) <| r.dependentPass (fun _ ↦ true) <|
      Case.initial (fun _ ↦ none) dom).lookup a) with
  | some v => v.map (·.1)
  | none => r.unmarked

/-- Voice's φ-probe, spelled out as Set A, agrees with the closest argument. -/
def setA (es : List Transitive) : Option Transitive := (heightOrder es).head?

/-- T's φ-probe, spelled out as Set B, agrees with the closest absolutive argument. -/
def setB (es : List Transitive) : Option Transitive :=
  (heightOrder es).find? fun a ↦ caseOf es a = some .abs

/-- When the adjacent probes on Voice and T cross-reference the same argument, anti-redundancy
deletes Voice's copy, and Voice is spelled out as the agent-focus morpheme. -/
def AgentFocus (es : List Transitive) : Prop := setA es = setB es

instance (es : List Transitive) : Decidable (AgentFocus es) :=
  inferInstanceAs (Decidable (_ = _))

/-- The subject is ergative when it merges first, absolutive when the object has moved before it;
in both cases the object is absolutive. -/
example :
    caseOf [.subj] .subj = some .erg ∧ caseOf [.subj] .obj = some .abs ∧
      caseOf [.obj, .subj] .subj = some .abs ∧ caseOf [.obj, .subj] .obj = some .abs := by
  decide

/-- **Agent focus.** In any transitive derivation with an external argument, Voice and T
cross-reference the same argument exactly when the object checks `[·D·]` before the wh-subject
merges. -/
theorem agentFocus_iff (w : Option Transitive) {es : List Transitive}
    (h : TransitiveDerivation w es) (hs : .subj ∈ es) : AgentFocus es ↔ es = [.obj, .subj] := by
  have hl : ∀ x, x ∈ [Transitive.vp, .obj, .subj] := by intro x; cases x <;> simp
  have hw : w ∈ [none, some .vp, some .obj, some .subj] := by
    rcases w with _ | w
    · simp
    · cases w <;> simp
  exact (by decide : ∀ w ∈ [none, some Transitive.vp, some .obj, some .subj],
    ∀ es ∈ lists [Transitive.vp, .obj, .subj] 3, TransitiveDerivation w es → .subj ∈ es →
      (AgentFocus es ↔ es = [.obj, .subj])) w hw es (mem_lists hl (length_le_of_transitive h)) h hs

/-! ### Passives of ditransitives -/

/-- The operations at v in a passive, once the phrase containing the indirect object has merged,
are raising the indirect object, merging VP, and raising the direct object. -/
inductive Passive where
  | iobj
  | vp
  | dobj
  deriving DecidableEq, Repr

/-- `Passive.phrase io dobj a` is the phrase operation `a` merges, given the indirect object `io`
and the direct object `dobj`. -/
def Passive.phrase (io dobj : Phrase) : Passive → Phrase
  | .iobj => io
  | .vp => ⟨.V, false⟩
  | .dobj => dobj

/-- `Passive.available done` lists the operations still available after `done`. The indirect
object is accessible from the start, the direct object only once VP has merged. -/
def Passive.available (done : List Passive) : List Passive :=
  [.iobj, .vp, .dobj].filter fun a ↦ a ∉ done ∧ (a = .dobj → .vp ∈ done)

/-- `afterXP` is the set of v's features left once the phrase containing the indirect object has
checked `[·X·]`. -/
def afterXP : Finset Feature := bundlev \ Phrase.checks ⟨.P, false⟩

/-- `Economical κ s done es` holds when, after the operations `done` and with `s` unchecked, the
operations `es` apply in order, each available, checking a feature, and permitted by Weak
Economy, until no available operation can check anything. -/
def Economical (κ : Passive → Finset Feature) :
    Finset Feature → List Passive → List Passive → Prop
  | s, done, [] => ∀ b ∈ Passive.available done, s ∩ κ b = ∅
  | s, done, e :: es => e ∈ Passive.available done ∧ (s ∩ κ e).Nonempty ∧
      WeakEconomy κ s (Passive.available done) e ∧ Economical κ (s \ κ e) (done ++ [e]) es

instance decEconomical (κ : Passive → Finset Feature) :
    (s : Finset Feature) → (done es : List Passive) → Decidable (Economical κ s done es)
  | _, _, [] => inferInstanceAs (Decidable (∀ b ∈ _, _))
  | s, done, e :: es =>
    haveI := decEconomical κ (s \ κ e) (done ++ [e]) es
    inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

theorem economical_cons {κ : Passive → Finset Feature} {s : Finset Feature}
    {done es : List Passive} {e : Passive} :
    Economical κ s done (e :: es) ↔ e ∈ Passive.available done ∧ (s ∩ κ e).Nonempty ∧
      WeakEconomy κ s (Passive.available done) e ∧ Economical κ (s \ κ e) (done ++ [e]) es :=
  Iff.rfl

/-- An economical derivation is licensed. -/
theorem Economical.licensed {κ : Passive → Finset Feature} {s : Finset Feature}
    {done es : List Passive} (h : Economical κ s done es) : Licensed κ s es := by
  induction es generalizing s done with
  | nil => trivial
  | cons e es ih =>
    obtain ⟨_, h₁, _, h₂⟩ := economical_cons.1 h
    exact licensed_cons.2 ⟨h₁, ih h₂⟩

/-- The passive subject is the argument checking v's `[·D·]`, the first that can. -/
def subject (κ : Passive → Finset Feature) (es : List Passive) : Option Passive :=
  es.find? fun a ↦ Feature.D ∈ κ a

/-- `PassiveDerivation io dobj es` says that `es` is a passive derivation at v with indirect
object `io` and direct object `dobj`. -/
abbrev PassiveDerivation (io dobj : Phrase) (es : List Passive) : Prop :=
  Economical (Phrase.checks ∘ Passive.phrase io dobj) afterXP [] es

private theorem length_le_of_passive {io dobj : Phrase} {es : List Passive}
    (h : PassiveDerivation io dobj es) : es.length ≤ 3 := by
  have := h.licensed.length_le
  have : afterXP.card = 3 := by decide
  omega

/-- **Symmetric passives.** With plain objects either one can become the subject. -/
theorem symmetric_passive :
    (∃ es, PassiveDerivation ⟨.D, false⟩ ⟨.D, false⟩ es ∧
      subject (Phrase.checks ∘ Passive.phrase ⟨.D, false⟩ ⟨.D, false⟩) es = some .iobj) ∧
    ∃ es, PassiveDerivation ⟨.D, false⟩ ⟨.D, false⟩ es ∧
      subject (Phrase.checks ∘ Passive.phrase ⟨.D, false⟩ ⟨.D, false⟩) es = some .dobj :=
  ⟨⟨[.iobj, .vp], by decide⟩, ⟨[.vp, .dobj], by decide⟩⟩

/-- **The double object movement asymmetry.** A wh indirect object checks `[·D·]` and `[·wh·]`
at once, so Weak Economy raises it before VP merges, and it is the subject of every passive
derivation. -/
theorem doma {es : List Passive} (h : PassiveDerivation ⟨.D, true⟩ ⟨.D, false⟩ es) :
    subject (Phrase.checks ∘ Passive.phrase ⟨.D, true⟩ ⟨.D, false⟩) es = some .iobj :=
  (by decide : ∀ es ∈ lists [Passive.iobj, .vp, .dobj] 3,
    PassiveDerivation ⟨.D, true⟩ ⟨.D, false⟩ es →
      subject (Phrase.checks ∘ Passive.phrase ⟨.D, true⟩ ⟨.D, false⟩) es = some .iobj)
    es (mem_lists (by intro x; cases x <;> simp) (length_le_of_passive h)) h

/-- A wh direct object becomes accessible only after VP merges, too late to force the order, so
either object can still become the subject. -/
theorem whDobj_symmetric :
    (∃ es, PassiveDerivation ⟨.D, false⟩ ⟨.D, true⟩ es ∧
      subject (Phrase.checks ∘ Passive.phrase ⟨.D, false⟩ ⟨.D, true⟩) es = some .iobj) ∧
    ∃ es, PassiveDerivation ⟨.D, false⟩ ⟨.D, true⟩ es ∧
      subject (Phrase.checks ∘ Passive.phrase ⟨.D, false⟩ ⟨.D, true⟩) es = some .dobj :=
  ⟨⟨[.iobj, .vp, .dobj], by decide⟩, ⟨[.vp, .dobj], by decide⟩⟩

/-- **No indirect object passives with inherent case.** An indirect object with an inherent-case
shell cannot check `[·D·]`, so it is never the passive subject, wh-phrase or not. -/
theorem iobj_kp_not_subject (wh : Bool) (dobj : Phrase) (es : List Passive) :
    subject (Phrase.checks ∘ Passive.phrase ⟨.K, wh⟩ dobj) es ≠ some .iobj := by
  intro h
  have := List.find?_some h
  simp [Passive.phrase] at this

end Newman2024
