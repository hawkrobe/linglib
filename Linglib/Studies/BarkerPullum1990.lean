import Linglib.Syntax.Tree.Command

/-!
# Barker and Pullum 1990: a theory of command relations

A command relation on a tree is generated by a property of nodes: `a` P-commands `b` when
every P-node properly dominating `a` dominates `b`. The definition settles what the
literature's informal definitions leave open — what "first branching node" means, and what
happens when no node qualifies — and yields the literature's relations by the choice of
generator alone: S-command from the S nodes, K-command from S and NP, MAX-command from the
maximal projections, classical c-command from the branching nodes, IDC-command from every
node. The central result is the Intersection Theorem, `C_P ∩ C_Q = C_{P ∪ Q}`, so that
K-command is S-command ∩ NP-command and Rouveret and Vergnaud's relation is
c-command ∩ MAX-command; with it come reflexivity, Ambidextrousness, Boundedness,
Constituency, Descent, Embeddability and Fairness, and the failure of Descent shows that
Klima's in-construction-with, the inverse of c-command, is no command relation. Mate
relations such as clausemate are a command relation intersected with its inverse, and
government relations intersect a command relation with the composition of head-of and a
command relation. Generating from relations rather than properties keeps everything but
Fairness and closes the class under union.

The substrate carries the definitions and the theorems (`Core/Order/Command.lean`) and the
category generators (`Syntax/Tree/Command.lean`); this file instantiates them on the paper's
configurations. Two of the paper's claims fail on its own definitions: Definition 12's
second characterization of mates, equality of upper-bound sets, is strictly stronger than
mutual command once a node may be its mate's upper bound, and so is the prose
characterization by equal command domains.

## References

* [barker-pullum-1990]
* [klima-1964]
* [davis-1987]
-/

namespace BarkerPullum1990

open Core.Order Core.Order.Branching Syntax Syntax.Tree

/-- The government schema: `a` governs `b` when `a` commands `b` and `b` bears to `a` the
composition of head-of with command. -/
def government {Node : Type} (C : Set (Node × Node)) (H : Node → Node → Prop) : Set (Node × Node) :=
  {ab | ab ∈ C ∧ ∃ x, Relation.ReflTransGen H ab.2 x ∧ (x, ab.1) ∈ C}

theorem government_subset {Node : Type} (C : Set (Node × Node)) (H : Node → Node → Prop) :
    government C H ⊆ C :=
  λ _ h => h.1

variable {Node : Type} [PartialOrder Node] (T : TreeOrder Node)

/-! ### The literature's relations -/

/-- IDC-command, generated by every node, is the smallest command relation. -/
theorem idcCommand_subset (P : Set Node) (hP : P ⊆ T.nodes) :
    idcCommand T ⊆ commandRelation T P :=
  idc_is_bottom T P hP

/-- A relation that fails Descent is no command relation. -/
theorem ne_commandRelation_of_not_descent {R : Set (Node × Node)} {a b c : Node}
    (hab : (a, b) ∈ R) (hbc : b ≤ c) (hac : (a, c) ∉ R) (P : Set Node) :
    R ≠ commandRelation T P :=
  λ h => hac (h ▸ command_descent T P a b c (h ▸ hab) hbc)

/-- Klima's in-construction-with, the inverse of c-command. -/
def inConstructionWith {W : Type*} (t : Tree Cat W) : Set (TreePath × TreePath) :=
  {ab | (ab.2, ab.1) ∈ cCommandAt t}

instance {W : Type*} (t : Tree Cat W) (ab : TreePath × TreePath) :
    Decidable (ab ∈ inConstructionWith t) :=
  inferInstanceAs (Decidable ((ab.2, ab.1) ∈ cCommandAt t))

/-- `[S [NP N N] V]`: the verb is in construction with the NP, which dominates its first
noun, but not with that noun. -/
def witness : Tree Cat Unit :=
  .node .S [.node .NP [.terminal .N (), .terminal .N ()], .terminal .V ()]

theorem inConstructionWith_ne_commandRelation (P : Set TreePath) :
    inConstructionWith witness ≠ commandRelation (toTreeOrder witness) P :=
  ne_commandRelation_of_not_descent _ (a := ⟨[1]⟩) (b := ⟨[0]⟩) (c := ⟨[0, 0]⟩) (by decide)
    (by decide) (by decide) P

/-! ### Mates -/

/-- Clausemates: S-mates. -/
abbrev clausemates {W : Type*} (t : Tree Cat W) : Set (TreePath × TreePath) :=
  mateRelation (toTreeOrder t) (labeled t {.S})

/-- The relation generated by the empty property holds of every pair, so it is its own
inverse and its own mate relation. -/
theorem mateRelation_empty : mateRelation T ∅ = commandRelation T ∅ := by
  ext ⟨a, b⟩; simp [mateRelation, commandRelation, Core.Order.upperBounds]

/-- `[S [S N N] V]`: a noun and the S above it are clausemates. -/
def nested : Tree Cat Unit :=
  .node .S [.node .S [.terminal .N (), .terminal .N ()], .terminal .V ()]

/-- Mutual command does not give equal upper-bound sets: the noun's bounds are both S
nodes, the lower S's only the root. -/
theorem clausemates_not_sameUpperBounds :
    (⟨[0, 0]⟩, ⟨[0]⟩) ∈ clausemates nested ∧
      Core.Order.upperBounds (toTreeOrder nested) ⟨[0, 0]⟩ (labeled nested {.S}) ≠
        Core.Order.upperBounds (toTreeOrder nested) ⟨[0]⟩ (labeled nested {.S}) :=
  ⟨by decide, λ h => (by decide : (⟨[0]⟩ : TreePath) ∉
    Core.Order.upperBounds (toTreeOrder nested) ⟨[0]⟩ (labeled nested {.S})) (h ▸ by decide)⟩

/-- Nor equal command domains: the lower S commands the verb, the noun does not. -/
theorem clausemates_not_sameDomain :
    (⟨[0]⟩, ⟨[1]⟩) ∈ sCommand nested ∧ (⟨[0, 0]⟩, ⟨[1]⟩) ∉ sCommand nested := by
  constructor <;> decide

/-! ### Government -/

/-- Davis's definition: every maximal projection dominates `b` iff it dominates `a`. -/
def davis (max : Set Node) (a b : Node) : Prop := ∀ P ∈ max, P ≤ b ↔ P ≤ a

/-- Its reconstruction: `a` and `b` are MAX-mates and neither dominates the other. -/
def davisRestated (max : Set Node) (a b : Node) : Prop :=
  (a, b) ∈ mateRelation T max ∧ ¬ a ≤ b ∧ ¬ b ≤ a

/-- Tree (25): `Z²` over `X¹` and `Y²`, `X¹` over `X⁰` (and a sister). -/
def tree25 : Tree Cat Unit :=
  .node .VP [.node .V [.terminal .V (), .terminal .N ()], .terminal .NP ()]

/-- The maximal projections of tree (25): `Z²` and `Y²`. -/
def max25 : Set TreePath := {p | p = ⟨[]⟩ ∨ p = ⟨[1]⟩}

instance (p : TreePath) : Decidable (p ∈ max25) :=
  inferInstanceAs (Decidable (p = ⟨[]⟩ ∨ p = ⟨[1]⟩))

/-- `X⁰` does not govern `Y²` on Davis's definition, since `Y²` dominates itself but not
`X⁰`. -/
theorem tree25_davis_fails : ¬ davis max25 ⟨[0, 0]⟩ ⟨[1]⟩ :=
  λ h => absurd ((h ⟨[1]⟩ (Or.inr rfl)).1 le_rfl) (by decide)

/-- On the reconstruction it does. -/
theorem tree25_davisRestated : davisRestated (toTreeOrder tree25) max25 ⟨[0, 0]⟩ ⟨[1]⟩ :=
  ⟨by decide, by decide, by decide⟩

/-! ### Relations as generators -/

/-- Fairness: an upper bound is an upper bound for every node it properly dominates. -/
def Fair (R : Set (Node × Node)) : Prop :=
  ∀ a b c, (a, b) ∈ R → (b, c) ∈ R → (a, c) ∉ R → ∀ d, (a, d) ∈ R → b ≤ d

theorem fair_commandRelation (P : Set Node) : Fair (commandRelation T P) :=
  command_fair T P

/-- A generator giving the first noun of `witness` its NP as sole bound candidate and every
other node none. -/
def unfairGenerator (x u : TreePath) : Prop := x = ⟨[0, 0]⟩ ∧ u = ⟨[0]⟩

/-- Generated from a relation, command can fail Fairness: the first noun commands its sister
and itself, the sister commands the verb, the noun does not, yet the sister does not
dominate the noun. -/
theorem not_fair_unfairGenerator :
    ¬ Fair (commandByRelation unfairGenerator) := λ h =>
  absurd (h ⟨[0, 0]⟩ ⟨[0, 1]⟩ ⟨[1]⟩ (λ _ ⟨_, hu⟩ => hu ▸ by decide)
    (λ _ ⟨hx, _⟩ => absurd hx (by decide)) (λ h => absurd (h ⟨[0]⟩ ⟨rfl, rfl⟩) (by decide))
    ⟨[0, 0]⟩ (λ _ ⟨_, hu⟩ => hu ▸ by decide)) (by decide)

end BarkerPullum1990
