module

public import Linglib.Syntax.Tree.Command
public import Linglib.Syntax.Tree.Projection

/-!
# Barker and Pullum 1990: a theory of command relations

Barker and Pullum generate a command relation from a property of nodes: `a` P-commands `b` when
every P-node properly dominating `a` dominates `b`. The literature's relations differ only in the
generator: S-command comes from the S nodes, K-command from S and NP, MAX-command from the maximal
projections, c-command from the branching nodes, and IDC-command from every node. By the
Intersection Theorem, `C_P ∩ C_Q = C_{P ∪ Q}`, K-command is S-command ∩ NP-command and Rouveret and
Vergnaud's relation is c-command ∩ MAX-command. Mate relations intersect a command relation with
its inverse, and government relations intersect one with the composition of head-of and command.

The definitions and the paper's theorems live in `Syntax/Command.lean` and the category generators
in `Syntax/Tree/Command.lean`; this file checks the trees they are stated over against the paper's
Definition 1 and instantiates them on the paper's configurations. Two of the paper's claims fail on
its own definitions: Definition 12's second characterization of mates, equality of upper-bound
sets, is strictly stronger than mutual command once a node may be its mate's upper bound, and so is
the prose characterization by equal command domains. On tree (25), whose maximal projections are
read off its heads, Davis's definition of government fails where the paper's restatement holds,
and the government schema with head-of reaches the head of a governed phrase.

## Main results

* `treePath_isTree`: positions under dominance and precedence satisfy Definition 1.
* `kCommand_eq`, `rvCommand_eq`: K-command and Rouveret and Vergnaud's relation as intersections.
* `inConstructionWith_ne_commandRelation`: Klima's in-construction-with, the inverse of
  c-command, fails Descent and so is no command relation.
* `clausemates_not_sameUpperBounds`, `clausemates_not_sameDomain`: mutual command gives neither
  equal upper-bound sets nor equal command domains.
* `tree25_davis_fails`, `tree25_governs`: on tree (25), `X⁰` governs `Y²` by (26) but not by
  Davis's (24).
* `tree25_governs_head`: Aoun and Lightfoot's government reaches the head of `Y²`.
* `not_fair_unfairGenerator`: command generated by a relation can fail Fairness.

## References

* [barker-pullum-1990]
* [klima-1964]
* [lasnik-1976]
* [rouveret-vergnaud-1980]
* [davis-1987]
-/

@[expose] public section

namespace BarkerPullum1990

open Core.Order Syntax Syntax.Tree

/-- In the government schema `a` governs `b` when `a` commands `b` and `b` bears to `a` the
composition of head-of with command. -/
def government {Node : Type} (C : Set (Node × Node)) (H : Node → Node → Prop) : Set (Node × Node) :=
  {ab | ab ∈ C ∧ ∃ x, Relation.ReflTransGen H ab.2 x ∧ (x, ab.1) ∈ C}

theorem government_subset {Node : Type} (C : Set (Node × Node)) (H : Node → Node → Prop) :
    government C H ⊆ C :=
  fun _ h => h.1

/-! ### Trees

Definition 1 adopts Wall's definition of a tree. Dominance is reflexive and antisymmetric with a
single root; precedence is irreflexive, asymmetric and transitive; two nodes are related by
dominance exactly when neither precedes the other (the Exclusivity Condition); and precedence
passes to the nodes each relatum dominates (the Nontangling Condition). -/

/-- Positions under prefix dominance and branch-order precedence satisfy the conditions of
Definition 1 on dominance and precedence. -/
theorem treePath_isTree :
    (∀ a : TreePath, ⊥ ≤ a) ∧ IsStrictOrder TreePath TreePath.Precedes ∧
      (∀ a b : TreePath, (a ≤ b ∨ b ≤ a) ↔ ¬ (a.Precedes b ∨ b.Precedes a)) ∧
      ∀ ⦃a b c d : TreePath⦄, a.Precedes b → a ≤ c → b ≤ d → c.Precedes d := by
  refine ⟨fun _ ↦ bot_le, inferInstance, fun a b ↦ ⟨?_, fun h ↦ ?_⟩, fun _ _ _ _ h ↦ h.mono⟩
  · rintro (h | h) (hp | hp)
    exacts [hp.not_le h, hp.not_ge h, hp.not_ge h, hp.not_le h]
  · rcases TreePath.Precedes.trichotomy a b with h' | h' | h' | h'
    exacts [.inl h', .inr h', absurd (.inl h') h, absurd (.inr h') h]

-- The ancestors of a position are linearly ordered: the Connected Ancestor Condition of
-- Definition 15, under which command relations obey Constituency.
example : IsLeftLinear TreePath := inferInstance

variable {Node : Type} [PartialOrder Node]

/-! ### The literature's relations -/

/-- IDC-command, generated by every node, is the smallest command relation. -/
theorem commandRelation_univ_subset (P : Set Node) :
    commandRelation Set.univ ⊆ commandRelation P :=
  commandRelation_anti (Set.subset_univ P)

section Labeled

variable {C W : Type*} [DecidableEq C]

/-- Rouveret and Vergnaud's c-command is generated by the branching nodes together with the
maximal projections. -/
abbrev rvCommand (t : Tree C W) : Set (TreePath × TreePath) :=
  commandRelation ({p | IsBranchingAt t p} ∪ Tree.maximalProjectionsAt t)

/-- Rouveret and Vergnaud's relation is c-command ∩ MAX-command. -/
theorem rvCommand_eq (t : Tree C W) : rvCommand t = cCommandAt t ∩ Tree.maxCommandAt t :=
  commandRelation_union _ _

/-- NP-command is generated by the NP nodes, the maximal projections of nouns. -/
abbrev npCommand (t : Tree Cat W) : Set (TreePath × TreePath) :=
  commandRelation (labeled t {.N} ∩ Tree.maximalProjectionsAt t)

/-- Lasnik's kommand is generated by the cyclic nodes, S and NP. -/
abbrev kCommand (t : Tree Cat W) : Set (TreePath × TreePath) :=
  commandRelation (labeled t {.S} ∪ (labeled t {.N} ∩ Tree.maximalProjectionsAt t))

/-- K-command is S-command ∩ NP-command. -/
theorem kCommand_eq (t : Tree Cat W) : kCommand t = sCommand t ∩ npCommand t :=
  commandRelation_union _ _

end Labeled

/-- A relation that fails Descent is no command relation. -/
theorem ne_commandRelation_of_not_descent {R : Set (Node × Node)} {a b c : Node}
    (hab : (a, b) ∈ R) (hbc : b ≤ c) (hac : (a, c) ∉ R) (P : Set Node) :
    R ≠ commandRelation P :=
  fun h => hac (h ▸ mem_commandRelation_of_le (h ▸ hab) hbc)

/-- Klima's in-construction-with is the inverse of c-command. -/
def inConstructionWith {W : Type*} (t : Tree Cat W) : Set (TreePath × TreePath) :=
  {ab | (ab.2, ab.1) ∈ cCommandAt t}

instance {W : Type*} (t : Tree Cat W) (ab : TreePath × TreePath) :
    Decidable (ab ∈ inConstructionWith t) :=
  inferInstanceAs (Decidable ((ab.2, ab.1) ∈ cCommandAt t))

/-- In `[S [NP N N] V]` the verb is in construction with the NP, which dominates its first
noun, but not with that noun. -/
def witness : Tree Cat Unit :=
  .node .S [.node .N [.terminal .N (), .terminal .N ()], .terminal .V ()]

theorem inConstructionWith_ne_commandRelation (P : Set TreePath) :
    inConstructionWith witness ≠ commandRelation P :=
  ne_commandRelation_of_not_descent (a := ⟨[1]⟩) (b := ⟨[0]⟩) (c := ⟨[0, 0]⟩) (by decide)
    (by decide) (by decide) P

/-! ### Mates -/

/-- Clausemates are S-mates. -/
abbrev clausemates {W : Type*} (t : Tree Cat W) : Set (TreePath × TreePath) :=
  mateRelation (labeled t {.S})

/-- The relation generated by the empty property holds of every pair, so it is its own
inverse and its own mate relation. -/
theorem mateRelation_empty : mateRelation (∅ : Set Node) = commandRelation ∅ := by
  ext ⟨a, b⟩; simp [mateRelation]

/-- In `[S [S N N] V]` a noun and the S above it are clausemates. -/
def nested : Tree Cat Unit :=
  .node .S [.node .S [.terminal .N (), .terminal .N ()], .terminal .V ()]

/-- Mutual command does not give equal upper-bound sets, since the noun's bounds are both S
nodes and the lower S's bound is the root alone. -/
theorem clausemates_not_sameUpperBounds :
    (⟨[0, 0]⟩, ⟨[0]⟩) ∈ clausemates nested ∧
      labeled nested {.S} ∩ Set.Iio ⟨[0, 0]⟩ ≠ labeled nested {.S} ∩ Set.Iio ⟨[0]⟩ :=
  ⟨by decide, fun h => (by decide : (⟨[0]⟩ : TreePath) ∉
    labeled nested {.S} ∩ Set.Iio ⟨[0]⟩) (h ▸ by decide)⟩

/-- Nor does it give equal command domains, since the lower S commands the verb and the noun
does not. -/
theorem clausemates_not_sameDomain :
    (⟨[0]⟩, ⟨[1]⟩) ∈ sCommand nested ∧ (⟨[0, 0]⟩, ⟨[1]⟩) ∉ sCommand nested := by
  constructor <;> decide

/-! ### Government

A governor is a minimal projection related to what it governs through the maximal projections,
here read off the tree's heads, one of the "more tree-dependent" ways of defining MAX that Barker
and Pullum allow. The head-of relation of the government schema is the head-daughter relation
reversed. -/

/-- On Davis's definition (24b) `a` governs `b` when every maximal projection dominates `b` iff it
dominates `a`. -/
def davis (max : Set Node) (a b : Node) : Prop := ∀ P ∈ max, P ≤ b ↔ P ≤ a

/-- The restatement (26c–d) of Davis's definition asks that `a` and `b` be MAX-mates and that
neither dominate the other. -/
def davisRestated (max : Set Node) (a b : Node) : Prop :=
  (a, b) ∈ mateRelation max ∧ ¬ a ≤ b ∧ ¬ b ≤ a

/-- By the restatement (26), `a` governs `b` in `t` when `a` is a minimal projection, of bar
level 0, and the two are MAX-mates neither dominating the other. Clause (b), on INFL, is left out,
since no category here is INFL. -/
def Governs {W : Type*} (t : Tree Cat W) (a b : TreePath) : Prop :=
  IsMinimalProjection (Tree.HeadDaughterAt t) a ∧ davisRestated (Tree.maximalProjectionsAt t) a b

/-- Tree (25) has `X²` over `X¹` and `Y²`, and `X¹` over `X⁰` alone; here `X` is a verb and `Y` a
noun, and `Y²`, which the figure leaves unexpanded, has a head `Y⁰`. -/
def tree25 : Tree Cat Unit :=
  .node .V [.node .V [.terminal .V ()], .node .N [.terminal .N ()]]

/-- `X⁰` does not govern `Y²` on Davis's definition, since `Y²` is a maximal projection that
dominates itself but not `X⁰`. -/
theorem tree25_davis_fails : ¬ davis (Tree.maximalProjectionsAt tree25) ⟨[0, 0]⟩ ⟨[1]⟩ :=
  fun h => absurd ((h ⟨[1]⟩ (by decide)).1 le_rfl) (by decide)

/-- On the restatement it does. -/
theorem tree25_governs : Governs tree25 ⟨[0, 0]⟩ ⟨[1]⟩ :=
  ⟨by decide, by decide, by decide, by decide⟩

/-- `X¹` and `Y²` are MAX-mates, but `X¹` does not govern `Y²`, since it projects from `X⁰`. -/
theorem tree25_not_governs_bar :
    davisRestated (Tree.maximalProjectionsAt tree25) ⟨[0]⟩ ⟨[1]⟩ ∧ ¬ Governs tree25 ⟨[0]⟩ ⟨[1]⟩ :=
  ⟨⟨by decide, by decide, by decide⟩, fun h => absurd h.1 (by decide)⟩

/-- In the government schema with MAX-command and head-of, Aoun and Lightfoot's government, `X⁰`
governs the head `Y⁰` of `Y²`, as they intend and their own definition fails to ensure. -/
theorem tree25_governs_head :
    (⟨[0, 0]⟩, ⟨[1, 0]⟩) ∈
      government (Tree.maxCommandAt tree25) (flip (Tree.HeadDaughterAt tree25)) :=
  ⟨by decide, ⟨[1]⟩, .single ⟨0, by decide, rfl⟩, by decide⟩

/-! ### Relations as generators -/

/-- A relation is fair when an upper bound is an upper bound for every node it properly
dominates. -/
def Fair (R : Set (Node × Node)) : Prop :=
  ∀ a b c, (a, b) ∈ R → (b, c) ∈ R → (a, c) ∉ R → ∀ d, (a, d) ∈ R → b ≤ d

theorem fair_commandRelation (P : Set Node) : Fair (commandRelation P) :=
  fun _ _ _ hab hbc hac _ had => commandRelation_fair hab hbc hac had

/-- This generator gives the first noun of `witness` its NP as sole bound candidate and every
other node none. -/
def unfairGenerator (x u : TreePath) : Prop := x = ⟨[0, 0]⟩ ∧ u = ⟨[0]⟩

/-- Generated from a relation, command can fail Fairness. The first noun commands its sister
and itself and the sister commands the verb, while the noun does not command the verb and the
sister does not dominate the noun. -/
theorem not_fair_unfairGenerator :
    ¬ Fair (commandByRelation unfairGenerator) := fun h =>
  absurd (h ⟨[0, 0]⟩ ⟨[0, 1]⟩ ⟨[1]⟩ (fun _ ⟨_, hu⟩ => hu ▸ by decide)
    (fun _ ⟨hx, _⟩ => absurd hx (by decide)) (fun h => absurd (h ⟨[0]⟩ ⟨rfl, rfl⟩) (by decide))
    ⟨[0, 0]⟩ (fun _ ⟨_, hu⟩ => hu ▸ by decide)) (by decide)

end BarkerPullum1990
