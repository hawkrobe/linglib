import Mathlib.Order.Filter.Ker
import Mathlib.Order.Filter.Finite
import Linglib.Discourse.CommonGround

/-!
# Commitments

A public commitment is a participant's undertaking to act as if a proposition holds
([hamblin-1970], [brandom-1994]): `committer` is committed to `content`. Three further
coordinates distinguish the frameworks built on commitments: whether the commitment is
undertaken or refused (Krifka's `S⊢φ` against `¬S⊢φ`, [krifka-2015]), the attitude it is a
commitment to — belief or preference ([condoravdi-lauer-2012]) — and whether it was generated by
the committer or attributed by the other party ([gunlogson-2008]). A discourse state records a
set of such commitments; the propositions it entails form the filter generated by the undertaken
contents, and the worlds it leaves open are that filter's kernel, so a commitment set projects
onto the Stalnakerian common ground of `Discourse/CommonGround.lean` by `Commitment.slate`.

## Main definitions

* `Commitment A W` — the atom, with `Commitment.Polarity`, `Commitment.Force`,
  `Commitment.Source`.
* `Commitment.State` — a commitment state: the set of commitments accumulated so far.
* `Commitment.contents`, `Commitment.slate`, `Commitment.contextSet` — what a state
  undertakes, entails, and leaves open.

## Main results

* `Commitment.ker_slate` — the context set is the kernel of the slate.
* `Commitment.contextSet_insert_of_commit` — a new commitment intersects the context set with
  its content.

## References

* [C. L. Hamblin, *Fallacies* (1970)][hamblin-1970]
* [R. Brandom, *Making It Explicit* (1994)][brandom-1994]
* [A. Cohen and M. Krifka, *Superlative quantifiers and meta-speech acts*
  (2014)][cohen-krifka-2014]
* [M. Krifka, *Bias in Commitment Space Semantics: Declarative Questions, Negated Questions,
  and Question Tags* (2015)][krifka-2015]
* [C. Condoravdi and S. Lauer, *Imperatives: Meaning and illocutionary force*
  (2012)][condoravdi-lauer-2012]
* [C. Gunlogson, *A Question of Commitment* (2008)][gunlogson-2008]
-/

/-- Whether a commitment is undertaken or refused. -/
inductive Commitment.Polarity
  | commit
  | refuse
  deriving DecidableEq, Repr

/-- The attitude a commitment is to: belief or preference. -/
inductive Commitment.Force
  | doxastic
  | preferential
  deriving DecidableEq, Repr

/-- Who generated the commitment: the committer, or the other party attributing it. -/
inductive Commitment.Source
  | selfGenerated
  | otherGenerated
  deriving DecidableEq, Repr

/-- A public commitment: `committer` is committed to `content`. -/
@[ext]
structure Commitment (A W : Type*) where
  committer : A
  content : Set W
  polarity : Commitment.Polarity := .commit
  force : Commitment.Force := .doxastic
  source : Commitment.Source := .selfGenerated

theorem Filter.generate_insert {W : Type*} (φ : Set W) (S : Set (Set W)) :
    Filter.generate (insert φ S) = Filter.generate S ⊓ Filter.principal φ :=
  le_antisymm
    (le_inf (Filter.le_generate_iff.2 fun _ hs =>
        Filter.mem_generate_of_mem (Set.mem_insert_of_mem _ hs))
      (Filter.le_principal_iff.2 (Filter.mem_generate_of_mem (Set.mem_insert _ _))))
    (Filter.le_generate_iff.2 (Set.insert_subset_iff.2
      ⟨Filter.mem_inf_of_right (Filter.mem_principal_self φ),
        fun _ hs => Filter.mem_inf_of_left (Filter.mem_generate_of_mem hs)⟩))

namespace Commitment

/-- A commitment state ([cohen-krifka-2014] §2.1, [krifka-2015]): the set of public commitments
the interlocutors have accumulated up to a point in conversation. -/
abbrev State (A W : Type*) := Set (Commitment A W)

variable {A W : Type*} (K : State A W)

open Filter

/-- `a` commits to `p`. -/
def commit (a : A) (p : Set W) (force : Force := .doxastic) (source : Source := .selfGenerated) :
    Commitment A W :=
  ⟨a, p, .commit, force, source⟩

/-- `a` refuses to commit to `p`. -/
def refuse (a : A) (p : Set W) (force : Force := .doxastic) (source : Source := .selfGenerated) :
    Commitment A W :=
  ⟨a, p, .refuse, force, source⟩

@[simp] theorem commit_polarity (a : A) (p : Set W) (f s) :
    (commit a p f s).polarity = .commit := rfl
@[simp] theorem refuse_polarity (a : A) (p : Set W) (f s) :
    (refuse a p f s).polarity = .refuse := rfl
@[simp] theorem commit_content (a : A) (p : Set W) (f s) : (commit a p f s).content = p := rfl
@[simp] theorem refuse_content (a : A) (p : Set W) (f s) : (refuse a p f s).content = p := rfl
@[simp] theorem commit_committer (a : A) (p : Set W) (f s) : (commit a p f s).committer = a := rfl

/-- The contents of the undertaken commitments in `K`. -/
def contents : Set (Set W) :=
  content '' {c ∈ K | c.polarity = .commit}

/-- The commitments of `a` in `K`. -/
def ofCommitter (a : A) : State A W := {c ∈ K | c.committer = a}

/-- The commitments in `K` to the attitude `f`: `PB` for belief, `PEP` for preference
([condoravdi-lauer-2012]). -/
def ofForce (f : Force) : State A W := {c ∈ K | c.force = f}

/-- The filter generated by the undertaken commitments in `K`: what `K` entails. -/
def slate : Filter W := generate (contents K)

/-- The worlds compatible with the undertaken commitments in `K`. -/
def contextSet : Set W := ⋂₀ contents K

/-- A commitment set's common ground is what it entails. -/
instance : HasCommonGround (State A W) W := ⟨slate⟩

theorem ker_slate : (slate K).ker = contextSet K := by
  simp [slate, contextSet, generate_eq_biInf, ker_iInf, Set.sInter_eq_biInter]

theorem mem_slate_of_mem {φ : Set W} (h : φ ∈ contents K) : φ ∈ slate K :=
  mem_generate_of_mem h

theorem contextSet_subset_of_mem_contents {φ : Set W} (h : φ ∈ contents K) : contextSet K ⊆ φ :=
  Set.sInter_subset_of_mem h

theorem contextSet_subset_of_mem_slate {φ : Set W} (h : φ ∈ slate K) : contextSet K ⊆ φ := by
  rw [← ker_slate, ker_def]
  exact Set.biInter_subset_of_mem h

/-- A consistent commitment set committed to `¬φ` does not entail `φ`. -/
theorem not_mem_slate_of_compl_mem {φ : Set W} (h : φᶜ ∈ contents K)
    (hne : (contextSet K).Nonempty) : φ ∉ slate K := fun hφ =>
  let ⟨_, hw⟩ := hne
  contextSet_subset_of_mem_contents K h hw (contextSet_subset_of_mem_slate K hφ hw)

variable {K}

theorem contents_mono {L : State A W} (h : K ⊆ L) : contents K ⊆ contents L :=
  Set.image_mono fun _ hc => ⟨h hc.1, hc.2⟩

theorem slate_mono {L : State A W} (h : K ⊆ L) : slate L ≤ slate K :=
  le_generate_iff.2 fun _ hφ => mem_generate_of_mem (contents_mono h hφ)

@[simp] theorem contents_empty : contents (∅ : State A W) = ∅ := by
  simp [contents]

@[simp] theorem slate_empty : slate (∅ : State A W) = ⊤ := by
  simp [slate, generate_empty]

theorem contents_insert_of_commit {c : Commitment A W} (h : c.polarity = .commit) :
    contents (insert c K) = insert c.content (contents K) := by
  ext φ
  simp only [contents, Set.mem_image, Set.mem_ofPred_eq, Set.mem_insert_iff]
  constructor
  · rintro ⟨d, ⟨rfl | hd, hp⟩, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨d, ⟨hd, hp⟩, rfl⟩
  · rintro (rfl | ⟨d, ⟨hd, hp⟩, rfl⟩)
    · exact ⟨c, ⟨Or.inl rfl, h⟩, rfl⟩
    · exact ⟨d, ⟨Or.inr hd, hp⟩, rfl⟩

theorem contents_insert_of_refuse {c : Commitment A W} (h : c.polarity = .refuse) :
    contents (insert c K) = contents K := by
  ext φ
  simp only [contents, Set.mem_image, Set.mem_ofPred_eq, Set.mem_insert_iff]
  constructor
  · rintro ⟨d, ⟨rfl | hd, hp⟩, rfl⟩
    · exact absurd (h.symm.trans hp) (by decide)
    · exact ⟨d, ⟨hd, hp⟩, rfl⟩
  · rintro ⟨d, ⟨hd, hp⟩, rfl⟩
    exact ⟨d, ⟨Or.inr hd, hp⟩, rfl⟩

/-- A new commitment adds its content to the slate. -/
theorem slate_insert_of_commit {c : Commitment A W} (h : c.polarity = .commit) :
    slate (insert c K) = slate K ⊓ 𝓟 c.content := by
  rw [slate, slate, contents_insert_of_commit h, Filter.generate_insert]

/-- A new commitment intersects the context set with its content. -/
theorem contextSet_insert_of_commit {c : Commitment A W} (h : c.polarity = .commit) :
    contextSet (insert c K) = c.content ∩ contextSet K := by
  simp [contextSet, contents_insert_of_commit h]

/-- The context set is the meet of the doxastic and the preferential context sets. -/
theorem contextSet_eq_inter_ofForce :
    contextSet K = contextSet (ofForce K .doxastic) ∩ contextSet (ofForce K .preferential) := by
  rw [contextSet, contextSet, contextSet, ← Set.sInter_union]
  congr 1
  ext φ
  simp only [contents, ofForce, Set.mem_image, Set.mem_ofPred_eq, Set.mem_union]
  constructor
  · rintro ⟨c, ⟨hc, hp⟩, rfl⟩
    cases h : c.force
    · exact Or.inl ⟨c, ⟨⟨hc, h⟩, hp⟩, rfl⟩
    · exact Or.inr ⟨c, ⟨⟨hc, h⟩, hp⟩, rfl⟩
  · rintro (⟨c, ⟨⟨hc, -⟩, hp⟩, rfl⟩ | ⟨c, ⟨⟨hc, -⟩, hp⟩, rfl⟩) <;> exact ⟨c, ⟨hc, hp⟩, rfl⟩

@[simp] theorem contextSet_empty : contextSet (∅ : State A W) = Set.univ := by
  simp [contextSet]

theorem contents_union (K L : State A W) :
    contents (K ∪ L) = contents K ∪ contents L := by
  ext φ
  simp only [contents, Set.mem_image, Set.mem_ofPred_eq, Set.mem_union]
  constructor
  · rintro ⟨c, ⟨hc | hc, hp⟩, rfl⟩
    exacts [Or.inl ⟨c, ⟨hc, hp⟩, rfl⟩, Or.inr ⟨c, ⟨hc, hp⟩, rfl⟩]
  · rintro (⟨c, ⟨hc, hp⟩, rfl⟩ | ⟨c, ⟨hc, hp⟩, rfl⟩)
    exacts [⟨c, ⟨Or.inl hc, hp⟩, rfl⟩, ⟨c, ⟨Or.inr hc, hp⟩, rfl⟩]

/-- Context sets intersect across a union of commitment sets. -/
theorem contextSet_union (K L : State A W) :
    contextSet (K ∪ L) = contextSet K ∩ contextSet L := by
  rw [contextSet, contents_union, Set.sInter_union]; rfl

/-- The contents of a family of commitments by `a` are the family's contents. -/
theorem contents_image_commit {ι : Type*} (a : A) (p : ι → Set W) (s : Set ι) :
    contents ((fun i => commit a (p i)) '' s) = p '' s := by
  ext φ
  simp only [contents, Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨c, ⟨⟨i, hi, rfl⟩, -⟩, rfl⟩
    exact ⟨i, hi, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨commit a (p i), ⟨⟨i, hi, rfl⟩, rfl⟩, rfl⟩

/-- A refusal leaves the context set alone. -/
theorem contextSet_insert_of_refuse {c : Commitment A W} (h : c.polarity = .refuse) :
    contextSet (insert c K) = contextSet K := by
  simp [contextSet, contents_insert_of_refuse h]

end Commitment
